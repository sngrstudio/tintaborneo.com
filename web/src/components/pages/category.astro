---
import FeaturedNews from '~/components/news/featured.astro'
import { FeaturedArticlePlaceholder } from '~/components/news/featured'
import { ArticlePlaceholder } from '~/components/news/article'

interface Props {
  category: string
}

const { category } = Astro.props
---

<FeaturedNews tag='berita-utama' categoryName={category} server:defer>
  <section class='mx-4 mb-8 grid grid-cols-1 gap-y-4' slot='fallback'>
    <FeaturedArticlePlaceholder />
    <ArticlePlaceholder />
  </section>
</FeaturedNews>

{/* Latest News */}
<div
  class='invisible'
  hx-get={`/dynamic/category-latest/?slug=${category}`}
  hx-trigger='load'
  hx-swap='outerHTML'
>
</div>
