---
import type { HTMLAttributes } from 'react'
import ArticleList, { Article } from './article'
import { Picture } from 'astro:assets'
import { getLiveCollection } from 'astro:content'

interface Props extends HTMLAttributes<HTMLElement> {
  title?: string | undefined
  first?: number | undefined
  after?: string | undefined
  tag?: string | undefined
  categoryName?: string | undefined
  notIn?: Array<string> | undefined
  search?: string | undefined
  lazyLoad?: boolean | undefined
}

const {
  title,
  first = 8,
  after,
  tag,
  categoryName,
  notIn,
  search,
  lazyLoad = false,
  className,
  ...props
} = Astro.props

const latestNews = await getLiveCollection('posts', {
  first,
  after,
  tag,
  categoryName,
  notIn,
  search
})

// Build query params for HTMX pagination
const buildQueryParams = () => {
  const params = new URLSearchParams()
  params.set('first', first.toString())
  if (tag) params.set('tag', tag)
  if (categoryName) params.set('categoryName', categoryName)
  if (search) params.set('search', search)
  if (notIn) notIn.forEach((id) => params.append('notIn', id))
  if (lazyLoad) params.set('lazyLoad', 'true')
  return params.toString()
}

const hasNextPage = latestNews.entries?.at(0)?.data.pageInfo.hasNextPage
const endCursor = latestNews.entries?.at(0)?.data.pageInfo.endCursor
---

<Fragment>
  {
    latestNews.entries && latestNews.entries.length > 0 && (
      <ArticleList title={title} className={className} {...props}>
        {latestNews.entries?.map((article) => (
          <Article
            title={article.data.title!}
            href={article.data.uri!}
            date={new Date(article.data.date! + '+07:00')}
          >
            {article.data.featuredImage && (
              <Picture
                class='aspect-[240/180] w-full overflow-hidden rounded-lg'
                src={article.data.featuredImage}
                width={240}
                height={180}
                layout='fixed'
                formats={['avif', 'webp']}
                alt=''
              />
            )}
          </Article>
        ))}
      </ArticleList>
    )
  }

  {
    lazyLoad && hasNextPage && endCursor && (
      <div
        class='invisible'
        hx-get={`/dynamic/news/?after=${endCursor}&${buildQueryParams()}`}
        hx-trigger='revealed'
        hx-swap='outerHTML'
      />
    )
  }
</Fragment>

<slot name='after-list' />
