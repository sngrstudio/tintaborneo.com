---
import type { HTMLAttributes } from 'react'
import ArticleList, { Article } from './article'
import { Picture } from 'astro:assets'
import { getLiveCollection } from 'astro:content'
import clsx from 'clsx'

interface Props extends HTMLAttributes<HTMLElement> {
  tag?: string
  categoryName?: string
  first?: number
  title?: string
}

const { tag, categoryName, first = 8, title, className, ...props } = Astro.props

const latestNews = await getLiveCollection('posts', {
  tag,
  categoryName,
  first
})
---

<Fragment>
  {
    latestNews.entries && latestNews.entries.length > 0 && (
      <ArticleList title={title} className={className} {...props}>
        {latestNews.entries?.map((article, i) => (
          <Article
            title={article.data.title!}
            href={article.data.uri!}
            date={new Date(article.data.date! + '+07:00')}
            className={clsx(i === 0 && '@md:col-span-2 @md:row-span-2')}
          >
            <Picture
              class='aspect-[240/180] w-full overflow-hidden'
              src={article.data.featuredImage!}
              width={240}
              height={180}
              layout='fixed'
              formats={['avif', 'webp']}
              alt=''
            />
          </Article>
        ))}
      </ArticleList>
    )
  }
</Fragment>

<slot name='after-list' />
