---
import type { HTMLAttributes } from 'react'
import ArticleList, { Article } from './article'
import { Picture } from 'astro:assets'
import { getLiveCollection } from 'astro:content'

interface Props extends HTMLAttributes<HTMLElement> {
  title?: string | undefined
  first?: number | undefined
  after?: string | undefined
  tag?: string | undefined
  categoryName?: string | undefined
  notIn?: Array<string> | undefined
  search?: string | undefined
  continuous?: boolean | undefined
}

const {
  title,
  first = 8,
  after,
  tag,
  categoryName,
  notIn,
  search,
  continuous,
  className,
  ...props
} = Astro.props

const latestNews = await getLiveCollection('posts', {
  first,
  after,
  tag,
  categoryName,
  notIn,
  search
})
---

<Fragment>
  {
    latestNews.entries && latestNews.entries.length > 0 && (
      <ArticleList title={title} className={className} {...props}>
        {latestNews.entries?.map((article) => (
          <Article
            title={article.data.title!}
            href={article.data.uri!}
            date={new Date(article.data.date! + '+07:00')}
          >
            {article.data.featuredImage && (
              <Picture
                class='aspect-[240/180] w-full overflow-hidden rounded-lg'
                src={article.data.featuredImage}
                width={240}
                height={180}
                layout='fixed'
                formats={['avif', 'webp']}
                alt=''
              />
            )}
          </Article>
        ))}
      </ArticleList>
    )
  }

  {
    continuous &&
      latestNews.entries?.at(0)?.data.pageInfo.hasNextPage &&
      latestNews.entries?.at(0)?.data.pageInfo.endCursor && (
        <Astro.self
          after={latestNews.entries?.at(0)?.data.pageInfo.endCursor as string}
          {...{
            first,
            tag,
            categoryName,
            notIn,
            search,
            continuous,
            className,
            ...props
          }}
        />
      )
  }
</Fragment>

<slot name='after-list' />
