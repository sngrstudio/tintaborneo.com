---
import News from '~/components/news/news.astro'
import { ArticlePlaceholder } from '~/components/news/article'

export const partial = true
export const prerender = false

const slug = Astro.url.searchParams.get('slug') ?? ''
---

<News
  title='Berita Terkini'
  categoryName={slug}
  first={12}
  className='mx-auto mb-16 max-w-screen-xl max-xl:px-4'
  lazyLoad={true}
  server:defer
>
  <ArticlePlaceholder
    className='mx-auto mb-16 max-w-screen-xl max-xl:px-4'
    slot='fallback'
  />
</News>
