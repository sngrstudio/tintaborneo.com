---
import Layout, { type Props as LProps } from '~/layouts/layout.astro'
import News from '~/components/news/news.astro'
import SearchIcon from '~icons/material-symbols/search'

export const prerender = false

const query = Astro.url.searchParams.get('q') ?? ''

const props = {
  title: 'Halaman Pencarian'
} satisfies LProps
---

<Layout class='pb-24'>
  <hgroup class='text-brand-primary -mt-[1rem] mb-4 px-4 py-8'>
    <div class='mx-auto max-w-screen-xl'>
      <h1 class='font-subheadings text-3xl font-black'>{props.title}</h1>
    </div>
  </hgroup>

  <div class='mx-auto mb-8 max-w-screen-xl max-xl:px-4'>
    <form
      class='border-brand-text/50 ring-brand-primary flex border focus:ring'
      action=''
      method='GET'
    >
      <input
        class='w-full border-0 ring-0'
        type='search'
        name='q'
        value={query}
        placeholder='Cari artikel'
      />
      <button class='pr-2' type='submit'>
        <SearchIcon />
      </button>
    </form>
  </div>

  {
    query ? (
      <News
        title='Hasil Pencarian'
        first={100}
        search={query}
        continuous={true}
        className='mx-auto mb-8 max-w-screen-xl max-xl:px-4 md:mb-16'
      />
    ) : (
      <div class='min-h-[55vh]' />
    )
  }
</Layout>
