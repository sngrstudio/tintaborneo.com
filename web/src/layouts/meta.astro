---
import { getEntry } from 'astro:content'

export interface Props {
  title?: string | undefined
  description?: string | undefined
  hide?: boolean | undefined
}

const { title, description, hide } = Astro.props
const siteData = await getEntry('site', 'SITE')
const site = {
  title: siteData?.data.title ?? '',
  description: siteData?.data.description ?? ''
} satisfies Omit<Props, 'hide'>
---

{/* Essential Metadata */}
<title>
  {
    title
      ? `${title} \u2014 ${site.title}`
      : `${site.title} \u2014 ${site.description}`
  }
</title>
<meta name='description' content={description || site.description} />
<link rel='canonical' href={Astro.url.href} />

{/* Icons */}
<link rel='icon' type='image/svg+xml' href='/favicon.svg' />

{/* SEO & Visibility Settings */}
<link rel='sitemap' href='/sitemap-index.xml' />
{hide && <meta name='robots' content='noindex, nofollow' />}
