---
import Layout, { type Props as LProps } from './layout.astro'
import { Picture } from 'astro:assets'
import { stripHTML } from '~/helpers/html'

export interface Props extends LProps {
  image?: string | undefined
  imageCaption?: string | undefined
}

const { title, image, imageCaption, class: className, ...props } = Astro.props
---

<Layout title={title} class:list={['pb-24', className]} {...props}>
  {/* <body /> */}
  <main
    class='prose lg:prose-lg prose-headings:font-headings prose-p:leading-snug mx-auto grid max-w-screen-lg grid-cols-1 gap-x-4 px-4 sm:grid-cols-3 lg:pt-8 xl:px-0'
  >
    {/* <hgroup - headings /> */}
    <hgroup class='sm:col-span-3'>
      <h1>{title}</h1>
      <slot name='hgroup' />

      {/* <image /> */}
      <Fragment>
        {
          image && (
            <figure>
              <Picture
                class='min-w-screen max-lg:-mx-4 lg:min-w-full'
                src={image}
                alt=''
                formats={['avif', 'webp']}
                layout='constrained'
                inferSize
                priority
              />
              {imageCaption && (
                <figcaption class='text-sm italic'>
                  {stripHTML(imageCaption)}
                </figcaption>
              )}
            </figure>
          )
        }
      </Fragment>
    </hgroup>

    {/* <main content /> */}
    <div class='sm:col-span-2'>
      <slot />
    </div>

    {/* <aside /> */}
    <aside
      class='not-prose mt-8 grid grid-cols-1 items-start gap-y-4 sm:mt-[1.25em]'
    >
      <slot name='aside' />
    </aside>
  </main>

  {/* <head /> */}
  <Fragment slot='head'>
    <slot name='head' />
  </Fragment>
</Layout>
