{
  "image": "mcr.microsoft.com/devcontainers/typescript-node:1-20-bullseye",
  "containerEnv": {
    "ADMIN_ENDPOINT": "https://content.tintaborneo.com"
  },
  "forwardPorts": [4321],
  "customizations": {
    "vscode": {
      "extensions": [
        "astro-build.astro-vscode",
        "bradlc.vscode-tailwindcss",
        "GitHub.vscode-github-actions"
      ]
    }
  },
  "postCreateCommand": "echo \"ADMIN_ENDPOINT=${ADMIN_ENDPOINT}\" > .dev.vars && corepack prepare && corepack enable && pnpm install --frozen-lockfile"
}
