---
import ArticleSection from '~/components/article/section.astro'
import ArticleList from '~/components/article/list.astro'
import LoadingIndicator from '~/components/loading-indicator.astro'
import { getLatestPosts } from '~/data/posts'

const category = Astro.url.searchParams.get('category')
const filter = Astro.url.searchParams.get('filter')
const cursor = Astro.url.searchParams.get('cursor')

const {
  data: { posts }
} = await getLatestPosts({
  tagNotIn: filter?.split(',') || [],
  categoryName: category || '',
  after: cursor || undefined
})

export const partial = true

// Headers configuration
Astro.response.headers.set(
  'Cache-Control',
  'public, max-age=0, must-revalidate'
)
Astro.response.headers.set(
  'CDN-Cache-Control',
  'public, s-maxage=30, stale-while-revalidate=60'
)
---

<ArticleSection>
  <ArticleList posts={posts?.nodes!} type='spotlight' />
</ArticleSection>

{/* Posts loader */}
<Fragment>
  {
    posts?.pageInfo.hasNextPage && (
      <div
        class='flex flex-col items-center justify-start h-[80vh] pt-24'
        hx-get={`/parts/list/?category=${category}&filter=${filter}&cursor=${posts?.pageInfo.endCursor}`}
        hx-trigger='revealed'
        hx-swap='outerHTML'
      >
        <LoadingIndicator />
      </div>
    )
  }
</Fragment>
