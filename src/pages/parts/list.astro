---
import type { Post } from '~/data/graphql'
import ArticleList from '~/components/article/list.astro'
import Separator from '~/components/separator.astro'
import LoadingIndicator from '~/components/loading-indicator.astro'
import { fetchPosts } from '~/data/posts'

const cursor = Astro.url.searchParams.get('cursor')
const amount = Astro.url.searchParams.get('amount')
const author = Astro.url.searchParams.get('author')
const category = Astro.url.searchParams.get('category')
const tag = Astro.url.searchParams.get('tag')
const infinite = Astro.url.searchParams.get('infinite')

const {
  data: { posts },
} = await fetchPosts({
  cursor: cursor || undefined,
  amount: Number(amount) || undefined,
  author: author || undefined,
  category: category || undefined,
  tag: tag || undefined,
})

export const partial = true
---

<ArticleList posts={posts?.nodes as Array<Post>} type="list" />
{
  infinite && posts?.pageInfo.hasNextPage && (
    <Fragment>
      <Separator
        class="md:hidden"
        hx-get={`/parts/list?tag=${tag}&amount=${amount}&cursor=${posts.pageInfo.endCursor}&infinite=true`}
        hx-trigger="revealed"
        hx-swap="outerHTML"
        hx-target="#list-slot"
      />
      <div
        id="list-slot"
        class="flex flex-col items-center justify-center h-[144px]">
        <LoadingIndicator />
      </div>
    </Fragment>
  )
}
