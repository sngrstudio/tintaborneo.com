---
import type { Post } from '~/graphql/types'
import Card from '~/components/sidebar/card.astro'
import LoadingIcon from '~icons/eos-icons/three-dots-loading'
import { getPostsBySearch } from '~/data/posts'

const query = Astro.url.searchParams.get('q')
const cursor = Astro.url.searchParams.get('cursor')

const posts = await getPostsBySearch({
  search: query || undefined,
  after: cursor || undefined
})

// Headers configuration
Astro.response.headers.set(
  'Cache-Control',
  'public, max-age=300, stale-while-revalidate=3600'
)

export const partial = true
---

<Fragment>
  {posts.nodes.map((post: Post) => <Card post={post} />)}
  {
    posts.pageInfo.hasNextPage && !!query && (
      <li
        class='mx-auto'
        hx-get={`/parts/search?q=${encodeURIComponent(query)}&cursor=${posts.pageInfo.endCursor}`}
        hx-swap='outerHTML'
        hx-trigger='intersect once'
      >
        <LoadingIcon class='text-xl text-tb-background/40 text-center' />
      </li>
    )
  }
</Fragment>
