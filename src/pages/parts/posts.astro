---
import ListPosts from '~/components/list/list.astro'
import { getLatestPosts } from '~/data/posts'
import { getCategory } from '~/data/taxonomies'

const categorySlug = Astro.url.searchParams.get('category')
const filter = Astro.url.searchParams.get('filter')

const category = await getCategory(categorySlug!)
const posts = await getLatestPosts({
  categoryName: categorySlug!,
  notIn: filter?.split(','),
  first: 8
})

// Headers configuration
Astro.response.headers.set(
  'Cache-Control',
  'public, max-age=1800, stale-while-revalidate=1800'
)
Astro.response.headers.set(
  'CDN-Cache-Control',
  'public, s-maxage=1800, stale-while-revalidate=3600'
)

export const partial = true
---

<section class='mx-auto w-full max-w-screen-lg'>
  <h2
    class='mb-4 border-t-2 border-tb-primary pt-2 font-subheading text-2xl font-bold uppercase text-tb-primary'
  >
    <a href={category?.uri}>{category?.name}</a>
  </h2>
  <ListPosts posts={posts.nodes} />
</section>
