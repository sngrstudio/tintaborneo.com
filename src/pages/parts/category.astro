---
import ArticleSection from '~/components/article/section.astro'
import ArticleList from '~/components/article/list.astro'
import { getCategoryId } from '~/data/taxonomies'
import { getCategoryPosts } from '~/data/posts'

const categoryId = Astro.url.searchParams.get('categoryId')
const filter = Astro.url.searchParams.get('filter')

const {
  data: { category }
} = await getCategoryId(categoryId!)
const {
  data: { posts }
} = await getCategoryPosts({
  categoryName: categoryId!,
  notIn: filter ? filter.split(',') : []
})

export const partial = true

// Headers configuration
Astro.response.headers.set(
  'Cache-Control',
  'public, max-age=0, must-revalidate'
)
Astro.response.headers.set(
  'CDN-Cache-Control',
  'public, s-maxage=30, stale-while-revalidate=60'
)
---

<ArticleSection
  title={category?.name!}
  uri={category?.uri!}
  type='primary'
  withHeader
>
  <ArticleList posts={posts?.nodes!} type='spotlight' />
</ArticleSection>
