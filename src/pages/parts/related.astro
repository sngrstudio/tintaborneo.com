---
import type { Post } from '~/data/graphql'
import ArticleList from '~/components/article/list.astro'
import ArticleSection from '~/components/article/section.astro'
import { fetchRelatedPosts } from '~/data/posts'

const id = Astro.url.searchParams.get('id')
const tagIds = Astro.url.searchParams.get('tagIds')

const {
  data: { posts }
} = await fetchRelatedPosts({
  tagIn: tagIds!.split(','),
  notIn: [id!],
  amount: 8
})

export const partial = true

// Headers configuration
Astro.response.headers.set(
  'Cache-Control',
  'public, max-age=60, stale-while-revalidate=90'
)
Astro.response.headers.set(
  'CDN-Cache-Control',
  'public, s-maxage=300, stale-while-revalidate=60'
)
---

<ArticleSection title='Berita Terkait' type='primary' withHeader singleRow>
  <ArticleList posts={posts?.nodes as Array<Post>} type='list' />
</ArticleSection>
