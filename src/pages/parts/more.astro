---
import ListPosts from '~/components/list/list.astro'
import ListLoader from '~/components/list/loader.astro'
import { getLatestPosts } from '~/data/posts'

const categorySlug = Astro.url.searchParams.get('category')
const filter = Astro.url.searchParams.get('filter')
const cursor = Astro.url.searchParams.get('cursor')

const posts = await getLatestPosts({
  categoryName: categorySlug!,
  after: cursor!,
  notIn: filter?.split(','),
  first: 8
})

export const partial = true

// Headers configuration
Astro.response.headers.set(
  'Cache-Control',
  'public, max-age=1800, stale-while-revalidate=3600'
)
Astro.response.headers.set(
  'CDN-Cache-Control',
  'public, s-maxage=1800, stale-while-revalidate=3600'
)
---

<ListPosts posts={posts.nodes} />
{
  posts.pageInfo.hasNextPage && (
    <ListLoader
      uri={`/parts/more?category=${categorySlug}&filter=${filter}&cursor=${posts.pageInfo.endCursor}`}
    />
  )
}
