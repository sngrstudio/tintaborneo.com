---
import { getPost } from '~/data/post'
import PageLayout from '~/layouts/page.astro'
import Share from '~/components/post/share.astro'
import Related from '~/components/post/related.astro'
import { getPicture } from '~/utils/picture'

const { post: postUri } = Astro.params

if (!postUri) return Astro.redirect('/404')

const slug = postUri.split('/').at(-1)!
const postData = await getPost(slug)
const post = {
  ...postData,
  optimizedImage: postData.featuredImage
    ? await getPicture({
        src: postData.featuredImage.node.sourceUrl!,
        inferSize: true,
        widths: [430, 736],
        sizes: '(max-width: 640px) 430px, 736px',
        loading: 'eager',
        caption: postData.featuredImage.node.caption || undefined
      })
    : undefined
}
---

<PageLayout
  title={post.title!}
  description={post.excerpt!.replace(/<[^>]*>|[&][a-zA-Z]+;/g, '')}
  image={post.optimizedImage}
>
  {/* <Content /> */}
  <Share slug={slug} />
  <Fragment set:html={post.content} />

  {/* <Aside /> */}
  <Fragment slot='aside'>
    <Related id={post.id} tags={post.tags?.nodes.map((tag) => tag.id) || []} />
  </Fragment>

  {/* <Head /> */}
  <Fragment slot='head'>
    {
      post.optimizedImage && (
        <link
          rel='preload'
          href={post.optimizedImage.sources.at(0)!.src}
          imagesrcset={post.optimizedImage.sources.at(0)!.srcSet.attribute}
          imagesizes={post.optimizedImage.sources.at(0)!.attributes.sizes}
          as='image'
        />
      )
    }
  </Fragment>
</PageLayout>
