---
import PageLayout from '~/layouts/page.astro'
import Infobox from '~/components/post/infobox.astro'
import { Picture } from 'astro:assets'
import { getPost } from '~/data/posts'

const { post: postUri } = Astro.params

const postSlug = postUri?.split('/').at(-1)
const post = await getPost(postSlug!)

if (!post) return Astro.redirect('/404')
---

<PageLayout
  title={post.title!}
  description={post.excerpt
    ? post.excerpt.replace(/<[^>]*>|[&][a-zA-Z]+;/g, '')
    : undefined}
>
  {/* Main Content */}
  <Fragment set:html={post.content} />

  {/* Headings */}
  <Fragment slot='heading'>
    <Infobox post={post} />
    {
      post.featuredImage && (
        <figure>
          <Picture
            src={post.featuredImage.node.sourceUrl!}
            inferSize
            loading={'eager'}
            alt={post.featuredImage.node.caption || post.title!}
          />
          {post.featuredImage.node.caption && (
            <figcaption
              class='text-tb-muted italic mt-2'
              set:html={post.featuredImage.node.caption}
            />
          )}
        </figure>
      )
    }
  </Fragment>
</PageLayout>
