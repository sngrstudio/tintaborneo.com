---
import Layout from '~/layouts/layout.astro'
import CarouselSection from '~/components/home/section.astro'
import FeaturedPosts from '~/components/home/featured.astro'
import LatestPosts from '~/components/home/latest.astro'
import { getTag } from '~/data/taxonomies'
import { getFeaturedPosts, getLatestPosts } from '~/data/posts'

const tag = await getTag('berita-utama')
const featuredPosts = await getFeaturedPosts()
const latestPosts = await getLatestPosts({
  tagNotIn: [tag?.id!],
  notIn: featuredPosts.nodes.map((post) => post.id)
})
---

<Layout>
  <main class='pt-[96px] px-4'>
    <CarouselSection>
      <FeaturedPosts posts={featuredPosts.nodes} class='md:col-span-2' />
      <LatestPosts posts={latestPosts.nodes} />
    </CarouselSection>
  </main>
</Layout>
