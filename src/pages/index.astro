---
import Layout from '~/layouts/layout.astro'
import HomeArticles from '~/components/home-articles.astro'

// Headers configuration
Astro.response.headers.set(
  'Cache-Control',
  'public, max-age=0, must-revalidate'
)
Astro.response.headers.set(
  'CDN-Cache-Control',
  'public, s-maxage=300, stale-while-revalidate=3600'
)
---

<Layout>
  <main class="flex flex-col gap-6 md:max-w-screen-lg md:mx-auto md:gap-12">
    <HomeArticles />
  </main>
</Layout>
