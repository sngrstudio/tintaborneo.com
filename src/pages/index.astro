---
import type { Post } from '~/data/graphql'
import Layout from '~/layouts/layout.astro'
import HomeArticles from '~/components/home/experimental_articles.astro'
import { getPicture } from '~/utils/image'
import {
  getTagId,
  getFeaturedPosts,
  getLatestPosts
} from '~/data/experimental_posts.ts'

const {
  data: { tag }
} = await getTagId('berita-utama')
const {
  data: { posts: featuredPostsData }
} = await getFeaturedPosts({ tagIn: [tag!.id] })
const {
  data: { posts: latestPostsData }
} = await getLatestPosts({ tagNotIn: [tag!.id] })

const featuredPosts = await Promise.all(
  featuredPostsData!.nodes.map(async (post: Post) => ({
    ...post,
    optimizedImage: post.featuredImage
      ? await getPicture({
          src: post.featuredImage.node.sourceUrl!,
          width: 800,
          height: 600,
          formats: ['avif', 'webp', 'jpeg'],
          widths: [250, 325, 430],
          sizes: '(max-width: 640px) 430px, (max-width: 768px) 250px, 325px',
          loading: 'eager'
        })
      : undefined
  }))
)

const latestPosts = await Promise.all(
  latestPostsData!.nodes.map(async (post: Post) => ({
    ...post,
    optimizedImage: post.featuredImage
      ? await getPicture({
          src: post.featuredImage.node.sourceUrl!,
          width: 800,
          height: 600,
          formats: ['avif', 'webp', 'jpeg'],
          widths: [250, 325, 430],
          sizes: '(max-width: 640px) 430px, (max-width: 768px) 250px, 325px'
        })
      : undefined
  }))
)

// Headers configuration
Astro.response.headers.set(
  'Cache-Control',
  'public, max-age=0, must-revalidate'
)
Astro.response.headers.set(
  'CDN-Cache-Control',
  'public, s-maxage=30, stale-while-revalidate=60'
)
---

<Layout>
  <main class='flex flex-col gap-6 md:max-w-screen-lg md:mx-auto md:gap-12'>
    <HomeArticles featuredPosts={featuredPosts} latestPosts={latestPosts} />
  </main>

  {/* Preloading images */}
  <Fragment slot='head'>
    {
      featuredPosts.map((entry) => (
        <Fragment>
          {entry.optimizedImage && (
            <Fragment>
              <link
                rel='preload'
                href={entry.optimizedImage.avif.src}
                imagesrcset={entry.optimizedImage.avif.srcSet.attribute}
                imagesizes={entry.optimizedImage.avif.attributes.sizes}
                type='image/avif'
                as='image'
              />
            </Fragment>
          )}
        </Fragment>
      ))
    }
    {
      latestPosts.map((entry) => (
        <Fragment>
          {entry.optimizedImage && (
            <Fragment>
              <link
                rel='preload'
                href={entry.optimizedImage.avif.src}
                imagesrcset={entry.optimizedImage.avif.srcSet.attribute}
                imagesizes={entry.optimizedImage.avif.attributes.sizes}
                type='image/avif'
                as='image'
              />
            </Fragment>
          )}
        </Fragment>
      ))
    }
  </Fragment>
</Layout>
