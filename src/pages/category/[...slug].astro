---
import Layout from '~/layouts/layout.astro'
import CarouselSection from '~/components/carousel/section.astro'
import FeaturedPosts from '~/components/carousel/featured.astro'
import LatestPosts from '~/components/carousel/latest.astro'
import ListPosts from '~/components/list/list.astro'
import ListLoader from '~/components/list/loader.astro'
import OGTags from '~/components/site/og-tags.astro'
import { getFeaturedPosts, getLatestPosts } from '~/data/posts'
import { getCategory } from '~/data/taxonomies'

const { slug } = Astro.params

const category = await getCategory(slug?.split('/').at(-1)!)

if (!category) return Astro.redirect('/404')

const allPosts = await getLatestPosts({
  categoryName: category?.slug!,
  first: 20
})

// if allPosts more than 20, get featuredPosts and latestPosts
const featuredPosts = allPosts.pageInfo.hasNextPage
  ? await getFeaturedPosts({ categoryName: slug })
  : undefined
const latestPosts =
  featuredPosts && featuredPosts.nodes.length > 0
    ? await getLatestPosts({
        categoryName: category?.slug!,
        notIn: featuredPosts.nodes.map((post) => post.id)
      })
    : undefined
const moreLatestPosts = await getLatestPosts({
  categoryName: category?.slug!,
  after:
    latestPosts && latestPosts.pageInfo.hasNextPage
      ? latestPosts.pageInfo.endCursor!
      : undefined,
  notIn: ([] as Array<string>)
    .concat(featuredPosts ? featuredPosts.nodes.map((post) => post.id) : [])
    .concat(latestPosts ? latestPosts.nodes.map((post) => post.id) : []),
  first: 8
})

const postLoaderFilter = ([] as Array<string>)
  .concat(featuredPosts ? featuredPosts.nodes.map((post) => post.id) : [])
  .concat(latestPosts ? latestPosts.nodes.map((post) => post.id) : [])
  .concat(moreLatestPosts ? moreLatestPosts.nodes.map((post) => post.id) : [])

// Headers configuration
Astro.response.headers.set(
  'Cache-Control',
  'public, max-age=300, stale-while-revalidate=300'
)
Astro.response.headers.set(
  'CDN-Cache-Control',
  'public, s-maxage=3600, stale-while-revalidate=3600'
)
---

<Layout
  title={category.name!}
  description={`Halaman Kategori ${category.name}`}
>
  <main class='grid grid-cols-1 gap-6 pt-[96px] px-4'>
    <h1
      class='font-heading font-black text-4xl text-tb-primary border-t-2 border-tb-primary pt-2 px-4 sm:px-0 mb-4 w-auto sm:w-full -mx-4 sm:max-w-screen-lg sm:mx-auto'
    >
      {category.name}
    </h1>
    <Fragment>
      {
        /* if posts < 20, render allPosts immediately */
        !allPosts.pageInfo.hasNextPage ? (
          <section class='max-w-screen-lg mx-auto min-h-[60vh]'>
            {allPosts.nodes.length > 0 ? (
              <ListPosts posts={allPosts.nodes} />
            ) : (
              <p class='text-center italic'>Belum ada berita.</p>
            )}
          </section>
        ) : (
          <Fragment>
            {
              /* if has featuredPosts & latestPosts, render carousel section */
              featuredPosts && latestPosts && (
                <CarouselSection>
                  <FeaturedPosts
                    posts={featuredPosts.nodes}
                    class='md:col-span-2'
                  />
                  <LatestPosts posts={latestPosts.nodes} />
                </CarouselSection>
              )
            }
            {/* always render moreLatestPosts regardless of carousel section availability */}
            <section class='max-w-screen-lg mx-auto'>
              <ListPosts posts={moreLatestPosts.nodes} />
            </section>
            {
              /* if category page has children, render category loader blocks */
              !category.parentId &&
                category.children &&
                category.children?.nodes.length > 0 &&
                category.children.nodes
                  .filter((c) => c.count)
                  .map((child) => (
                    <ListLoader
                      uri={`/parts/posts?category=${child.slug}&filter=${postLoaderFilter.join(',')}`}
                    />
                  ))
            }
            {
              /*if moreLatestPosts has next page, render loader block */
              moreLatestPosts.pageInfo.hasNextPage && (
                <section class='max-w-screen-lg mx-auto w-full'>
                  <h2 class='font-subheading font-bold text-2xl text-tb-primary uppercase border-t-2 border-tb-primary pt-2 mb-4'>
                    Selengkapnya
                  </h2>
                  <ListLoader
                    uri={`/parts/more?category=${category.slug}&filter=${postLoaderFilter.join(',')}&cursor=${
                      moreLatestPosts.pageInfo.endCursor
                    }`}
                  />
                </section>
              )
            }
          </Fragment>
        )
      }
    </Fragment>
  </main>

  {/* Head */}
  <Fragment slot='head'>
    <OGTags
      title={category.name!}
      description={`Halaman Kategori ${category.name}`}
    />
  </Fragment>
</Layout>
