---
import type { Category } from '~/data/graphql'
import Layout from '~/layouts/layout.astro'
import PageHeader from '~/layouts/page-header.astro'
import ArticleListByCategory from '~/components/article/list-by-category.astro'
import LoadingIndicator from '~/components/loading-indicator.astro'
import { fetchCategory } from '~/data/taxonomies'

const { category: categoryId } = Astro.params
const {
  data: { category },
} = await fetchCategory(categoryId!)
if (!category) return Astro.redirect('/404')
const subcategories = category.children?.nodes
---

<Layout title={category.name!}>
  <main class="flex flex-col gap-6 pt-16 pb-16">
    <PageHeader title={category.name!} type="primary" />
    <ArticleListByCategory categoryId="berita-utama" />
    {
      subcategories?.map((entry: Category) => (
        <Fragment>
          {entry.posts?.nodes.length! > 0 && (
            <div
              class="flex flex-col items-center justify-center h-[144px]"
              hx-get={`/parts/category/?id=${entry.slug}`}
              hx-trigger="revealed"
              hx-swap="outerHTML">
              <LoadingIndicator />
            </div>
          )}
        </Fragment>
      ))
    }
  </main>
</Layout>
