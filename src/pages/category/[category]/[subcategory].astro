---
import ListLayout from '~/layouts/list.astro'
import ArticleListLoader from '~/components/article/list-loader.astro'
import { fetchCategory } from '~/data/taxonomies'

const { subcategory: categoryId } = Astro.params
const {
  data: { category },
} = await fetchCategory(categoryId!)
if (!category) return Astro.redirect('/404')

// Headers configuration
Astro.response.headers.set(
  'Cache-Control',
  'public, max-age=300, stale-while-revalidate=3600'
)
Astro.response.headers.set(
  'CDN-Cache-Control',
  'public, s-maxage=3600, stale-while-revalidate=86400'
)
---

<ListLayout title={category.name!} description={category.description!}>
  <ArticleListLoader
    type="category"
    slug={category.slug!}
    amount={12}
    lazyload={false}
    isInfinite
  />
</ListLayout>
