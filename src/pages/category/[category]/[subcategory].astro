---
import type { Post } from '~/data/graphql'
import ListLayout from '~/layouts/list.astro'
import ArticleList from '~/components/article/list.astro'
import Separator from '~/components/separator.astro'
import LoadingIndicator from '~/components/loading-indicator.astro'
import { fetchCategory } from '~/data/taxonomies'
import { fetchPosts } from '~/data/posts'

const AMOUNT = 12

const { subcategory: categoryId } = Astro.params
const {
  data: { category },
} = await fetchCategory(categoryId!)
if (!category) return Astro.redirect('/404')
const {
  data: { posts },
} = await fetchPosts({
  amount: AMOUNT,
  category: category.slug!,
})
---

<ListLayout title={category.name!} description="">
  <ArticleList posts={posts?.nodes as Array<Post>} />
  {
    posts?.pageInfo.hasNextPage && (
      <Fragment>
        <Separator
          hx-get={`/parts/list?tag=${category.slug}&amount=${AMOUNT}&cursor=${posts.pageInfo.endCursor}&infinite=true`}
          hx-trigger="revealed"
          hx-swap="outerHTML"
          hx-target="#list-slot"
        />
        <div
          id="list-slot"
          class="flex flex-col items-center justify-center h-[144px]">
          <LoadingIndicator />
        </div>
      </Fragment>
    )
  }
</ListLayout>
