---
import type { Tag } from '~/graphql/types'
import PageLayout from '~/layouts/page.astro'
import Infobox from '~/components/post/infobox.astro'
import Related from '~/components/post/related.astro'
import Share from '~/components/post/share.astro'
import OGTags from '~/components/site/og-tags.astro'
import JSONLD from '~/components/post/jsonld.astro'
import { Picture } from 'astro:assets'
import { getPost } from '~/data/posts'

const { post: postUri } = Astro.params
const post = await getPost(postUri!)

if (!post) return Astro.redirect('/404')

// set ISR cache
Astro.locals.cache(60)

// Headers configuration
Astro.response.headers.set(
  'Cache-Control',
  'public, max-age=2629800, stale-while-revalidate=2629800'
)
Astro.response.headers.set(
  'CDN-Cache-Control',
  'public, s-maxage=2629800, stale-while-revalidate=2629800'
)
---

<PageLayout
  title={post.title!}
  description={post.excerpt
    ? post.excerpt.replace(/<[^>]*>|[&][a-zA-Z]+;/g, '')
    : undefined}
>
  {/* Main Content */}
  <Fragment set:html={post.content} />

  {/* Headings */}
  <Fragment slot='heading'>
    <Infobox post={post} />
    {
      post.featuredImage && (
        <figure class='-mx-4 sm:mx-0'>
          <Picture
            class='w-full sm:rounded-xl'
            src={post.featuredImage.node.sourceUrl!}
            formats={['avif', 'webp']}
            widths={[412, 560, 910]}
            inferSize
            sizes='(min-width: 1024px) 910px, (min-width: 768px) 560px, 412px'
            loading={'eager'}
            alt={post.featuredImage.node.caption || post.title!}
          />
          {post.featuredImage.node.caption && (
            <figcaption
              class='mt-2 px-4 italic text-tb-muted sm:px-0'
              set:html={post.featuredImage.node.caption}
            />
          )}
        </figure>
      )
    }
    <Share post={post} />
  </Fragment>

  {/* Related Posts */}
  <Fragment slot='aside'>
    <Related
      notIn={[post.id]}
      tagIn={post.tags?.nodes.map((tag) => tag.id) || []}
    />
  </Fragment>

  {/* Metadata */}
  <Fragment slot='head'>
    <OGTags
      title={post.title!}
      description={post.excerpt
        ? post.excerpt.replace(/<[^>]*>|[&][a-zA-Z]+;/g, '')
        : undefined}
      image={post.featuredImage
        ? post.featuredImage.node.sourceUrl!
        : undefined}
      imageAlt={post.featuredImage
        ? post.featuredImage.node.caption!
        : post.title!}
      date={new Date(post.date!)}
      author={post.author?.node.name!}
      categories={post.categories?.nodes.map((category) => category.name!)}
      tags={post.tags?.nodes.map((tag: Tag) => tag.name!)}
      type='article'
    />
    <JSONLD post={post} />
  </Fragment>
</PageLayout>
