---
import ListLayout from '~/layouts/list.astro'
import ArticleListLoader from '~/components/article/list-loader.astro'
import { fetchTag } from '~/data/taxonomies'

const { tag: tagId } = Astro.params
const {
  data: { tag }
} = await fetchTag(tagId!)
if (!tag) return Astro.redirect('/404')

// Headers configuration
Astro.response.headers.set(
  'Cache-Control',
  'public, max-age=300, stale-while-revalidate=3600'
)
Astro.response.headers.set(
  'CDN-Cache-Control',
  'public, s-maxage=3600, stale-while-revalidate=86400'
)
---

<ListLayout
  title={`Tag: ${tag.name}`}
  description={`Daftar berita dengan topik ${tag.name}`}
>
  <ArticleListLoader
    type='tag'
    slug={tag.slug!}
    amount={12}
    lazyload={false}
    isInfinite
  />
</ListLayout>
