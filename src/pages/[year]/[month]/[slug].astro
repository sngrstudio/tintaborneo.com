---
import type { Tag } from '~/data/graphql'
import PageLayout from '~/layouts/page.astro'
import { Picture } from 'astro:assets'
import { fetchPost } from '~/data/posts'
import { getDateString } from '~/utils/date'

const { slug } = Astro.params
const {
  data: { post },
} = await fetchPost(slug!)
if (!post) return Astro.redirect('/404')

// Headers configuration
Astro.response.headers.set(
  'Cache-Control',
  'public, max-age=3600, stale-while-revalidate=3600'
)
Astro.response.headers.set(
  'CDN-Cache-Control',
  'public, s-maxage=86400, stale-while-revalidate=604800'
)
---

<PageLayout
  title={post.title!}
  description={post.excerpt!.replace(/<[^>]*>|[&][a-zA-Z]+;/g, '')}
  post={post}>
  {/* header */}
  <Fragment slot="header">
    <div class="not-prose font-sans text-tb-muted">
      <p>
        <time datetime={post.date}>
          {getDateString(new Date(post.date!))}
        </time>
      </p>
      <p>
        Oleh <b>
          <a href={post.author?.node.uri}>{post.author?.node.name}</a>
        </b>
      </p>
    </div>
    {
      post.featuredImage && (
        <figure class="-mx-4 md:mx-0">
          <Picture
            class="w-full"
            src={post.featuredImage.node.sourceUrl!}
            alt={post.featuredImage.node.altText || post.title!}
            widths={[430, 736]}
            sizes="(max-width: 640px) 430px, 736px"
            formats={['avif', 'webp']}
            loading="eager"
            inferSize
          />
          <figcaption
            class="px-4 md:px-0"
            set:html={post.featuredImage.node.caption}
          />
        </figure>
      )
    }
  </Fragment>

  {/* post content */}
  <Fragment set:html={post.content} />

  {/* tag list */}
  <div class="not-prose text-tb-muted text-sm">
    <p>
      <b>Topik:</b>
      {
        post.tags?.nodes.map((tag: Tag, i, arr) => (
          <>
            <a class="hover:underline" href={tag.uri}>
              {tag.name}
            </a>
            {i < arr.length - 1 && <span>,&nbsp;</span>}
          </>
        ))
      }
    </p>
  </div>
</PageLayout>
