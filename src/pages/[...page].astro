---
import PageLayout from '~/layouts/page.astro'
import { Picture } from 'astro:assets'
import { getPage } from '~/data/site'

const { page: pageUri } = Astro.params

const page = await getPage(pageUri!)

if (!page || page.status !== 'publish') return Astro.redirect('/404')

// Headers configuration
Astro.response.headers.set('Cache-Control', 'public, max-age=0')
---

<PageLayout title={page.title!} description={page.title!}>
  {/* Main Content */}
  <Fragment set:html={page.content} />

  {/* Headings */}
  <Fragment slot='heading'>
    {
      page.featuredImage && (
        <figure class='-mx-4 sm:mx-0'>
          <Picture
            class='w-full sm:rounded-xl'
            src={page.featuredImage.node.sourceUrl!}
            formats={['avif', 'webp']}
            widths={[412, 560, 910]}
            inferSize
            sizes='(min-width: 1024px) 910px, (min-width: 768px) 560px, 412px'
            loading={'eager'}
            alt={page.featuredImage.node.caption || page.title!}
          />
          {page.featuredImage.node.caption && (
            <figcaption
              class='mt-2 px-4 italic text-tb-muted sm:px-0'
              set:html={page.featuredImage.node.caption}
            />
          )}
        </figure>
      )
    }
  </Fragment>

  {/* Metadata */}
  <Fragment slot='head'> </Fragment>
</PageLayout>
