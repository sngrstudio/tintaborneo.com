---
import ErrorLayout from '~/layouts/error.astro'

interface Props {
  error: unknown
}

const { error } = Astro.props

const title = '500 Server Error'
const message =
  error instanceof Error
    ? `Terjadi kesalahan internal: ${error.message}`
    : 'Terjadi kesalahan internal.'
---

<ErrorLayout title={title} message={message} />
