---
import ListLayout from '~/layouts/list.astro'
import ArticleListLoader from '~/components/article/list-loader.astro'
import { fetchUser } from '~/data/taxonomies'

const { author: authorId } = Astro.params
const {
  data: { user: author },
} = await fetchUser(authorId!)
if (!author) return Astro.redirect('/404')

// Headers configuration
Astro.response.headers.set(
  'Cache-Control',
  'public, max-age=300, stale-while-revalidate=3600'
)
Astro.response.headers.set(
  'CDN-Cache-Control',
  'public, s-maxage=3600, stale-while-revalidate=86400'
)
---

<ListLayout
  title={author.name!}
  description={author.description || 'Jurnalis TintaBorneo.com'}>
  <ArticleListLoader
    type="user"
    slug={author.slug!}
    amount={12}
    lazyload={false}
    isInfinite
  />
</ListLayout>
