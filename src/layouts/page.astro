---
import type { GetPictureResult } from '~/utils/picture'
import Layout, { type Props as LayoutProps } from './layout.astro'
import Image from '~/components/post/image.astro'

interface Props extends LayoutProps {
  image?: GetPictureResult
}

const { title, description, image } = Astro.props
---

<Layout title={title} description={description}>
  {/* <head /> */}
  <Fragment slot='head'>
    <slot name='head' />
  </Fragment>

  {/* <body /> */}
  <main
    class='max-w-screen-xl min-h-screen pt-[64px] md:pt-[96px] px-4 mx-auto'
  >
    {/* <MainArticle /> */}
    <section class='grid grid-cols-1 sm:grid-cols-3 lg:grid-cols-7 gap-4'>
      <article
        class:list={[
          'prose font-heading pt-12 max-w-screen-xl',
          { 'sm:col-span-2 lg:col-span-5': Astro.slots.has('aside') },
          { 'sm:col-span-3 lg:col-span-7': !Astro.slots.has('aside') }
        ]}
      >
        {/* <ArticleHeader /> */}
        <hgroup>
          <h1>{title}</h1>

          {/* <HeaderSlot /> */}
          <slot name='header' />

          {/* <ArticleImage /> */}
          <Fragment>
            {
              image && (
                <figure class='w-full'>
                  <Image image={image} class='block w-full object-cover' />
                  {image.caption && <figcaption>{image.caption}</figcaption>}
                </figure>
              )
            }
          </Fragment>
        </hgroup>

        {/* <Content /> */}
        <slot />
      </article>

      {/* <Aside /> */}
      <Fragment>
        {
          Astro.slots.has('aside') && (
            <aside class='lg:col-span-2 sm:pt-12'>
              <slot name='aside' />
            </aside>
          )
        }
      </Fragment>
    </section>
  </main>
</Layout>
