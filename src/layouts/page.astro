---
import Layout from '~/layouts/layout.astro'

interface Props {
  title?: string
  description?: string
}

const { title, description } = Astro.props
---

<Layout title={title} description={description}>
  {/* head */}
  <Fragment slot="head">
    <slot name="head" />
  </Fragment>

  {/* body */}
  <main class="pt-24 pb-16">
    <section>
      <article class="prose font-heading max-w-none px-4">
        <hgroup>
          <h1>{title}</h1>
          <slot name="header" />
        </hgroup>
        <slot />
      </article>
    </section>
    <slot name="aftercontent" />
  </main>
</Layout>
