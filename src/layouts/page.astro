---
import type { LayoutProps } from './layout'
import Layout from '~/layouts/layout.astro'

interface Props extends LayoutProps {}

const { title, description } = Astro.props
---

<Layout title={title} description={description}>
  {/* head */}
  <Fragment slot="head">
    <slot name="head" />
  </Fragment>

  {/* body */}
  <main class="max-w-screen-lg min-h-[60vh] mx-auto">
    <section>
      <article
        class="prose font-heading max-w-none md:prose-lg md:max-w-screen-md md:mx-auto px-4">
        <hgroup>
          <slot name="subtitle" />
          <h1>{title}</h1>
          <slot name="header" />
        </hgroup>
        <slot />
      </article>
    </section>
    <slot name="aftercontent" />
  </main>
</Layout>
