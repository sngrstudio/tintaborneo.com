---
import type { LayoutProps } from './layout'
import Layout from './layout.astro'

interface Props extends LayoutProps {}

const { title, description } = Astro.props
---

<Layout title={title} description={description}>
  {/* head */}
  <Fragment slot="head">
    <slot name="head" />
  </Fragment>

  {/* body */}
  <main class="flex flex-col gap-6 pt-16 pb-16">
    <hgroup class="border-t-2 border-tb-muted px-4 py-2">
      <h1 class="font-heading font-bold text-3xl text-tb-muted">
        {title}
      </h1>
    </hgroup>
    <section class="flex flex-col gap-3 px-4">
      <slot />
    </section>
  </main>
</Layout>
