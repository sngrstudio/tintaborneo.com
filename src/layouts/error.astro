---
import Layout, { type Props as LayoutProps } from './layout.astro'

interface Props extends Required<Pick<LayoutProps, 'title'>> {
  message: string
}

const { title, message } = Astro.props
---

<Layout title={title} description={message}>
  <main class='px-4 pt-[90px]'>
    <section
      class='flex min-h-[80vh] flex-col items-center justify-center gap-2'
    >
      <h1 class='font-heading text-4xl font-black text-tb-primary'>{title}</h1>
      <p class='text-lg'>{message}</p>
      <a
        class='text-tb-primary hover:underline'
        href='/'
        role='button'
        data-astro-prefetch
      >
        Beranda
      </a>
    </section>
  </main>
</Layout>
