---
import Layout, { type Props as LayoutProps } from './layout.astro'

interface Props extends Required<Pick<LayoutProps, 'title'>> {
  message: string
}

const { title, message } = Astro.props
---

<Layout title={title} description={message}>
  {/* body */}
  <main class='flex flex-col pt-24 pb-16 min-h-screen'>
    <section
      class='flex-1 flex flex-col items-center justify-center gap-2 h-full text-center px-4'
    >
      <h1 class='font-heading font-black text-5xl text-tb-primary'>{title}</h1>
      <p class='text-lg'>{message}</p>
    </section>
  </main>
</Layout>
