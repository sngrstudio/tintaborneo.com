---
import type { LayoutProps } from './layout'
import BaseLayout from './base.astro'
import Header from '~/components/header.astro'
import Footer from '~/components/footer.astro'
import Sidebar from '~/components/sidebar/sidebar.astro'
import Alert from '~/components/alert.astro'
import SEO from '~/components/seo.astro'

import '@fontsource/source-serif-pro/400.css'
import '@fontsource/source-serif-pro/700.css'
import '@fontsource/source-serif-pro/900.css'
import '@fontsource/martel-sans/400.css'
import '@fontsource/martel-sans/700.css'

interface Props extends LayoutProps {}

const { title, description, post } = Astro.props
---

<BaseLayout>
  {/* <head/> */}
  <Fragment slot="head">
    <SEO title={title} description={description} post={post} />
    <slot name="head" />
  </Fragment>

  {/* <body/> */}
  <Fragment>
    <Header />
    <slot />
    <Sidebar />
    <Footer />
    <Alert message="Ini adalah tampilan ujicoba dan belum dirilis ke publik." />
  </Fragment>
</BaseLayout>

<style is:global>
  [x-cloak] {
    display: none !important;
  }
</style>
