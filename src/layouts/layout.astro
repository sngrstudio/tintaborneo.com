---
import BaseLayout, { type Props as BaseLayoutProps } from './base.astro'
import SEO, { type Props as SEOProps } from '../components/site/seo.astro'
import Header from '~/components/header/header.astro'
import Sidebar from '~/components/sidebar/sidebar.astro'
import Footer from '~/components/footer/loader.astro'
import Analytics from '~/components/extra/analytics.astro'
import SourceSerifPro400Preload from '@fontsource/source-serif-pro/files/source-serif-pro-latin-400-normal.woff2?url'
import '@fontsource/source-serif-pro/400.css'
import '@fontsource/source-serif-pro/700.css'
import '@fontsource/source-serif-pro/900.css'
import '@fontsource/martel-sans/400.css'
import '@fontsource/martel-sans/700.css'

export interface Props extends SEOProps, Omit<BaseLayoutProps, 'title'> {}

const { title, description, ...attrs } = Astro.props
---

<BaseLayout
  class='min-h-screen bg-tb-background text-tb-text'
  x-data='{lockScroll: false}'
  x-on:setlockscroll.window='lockScroll=$event.detail'
  x-bind:class="{'overflow-hidden': lockScroll}"
  {...attrs}
>
  {/* <Head /> */}
  <Fragment slot='head'>
    <SEO title={title} description={description} />
    <slot name='head' />
    <link
      rel='preload'
      as='font'
      type='font/woff2'
      href={SourceSerifPro400Preload}
    />
    <Analytics />
  </Fragment>

  {/* <Body /> */}
  <Header />
  <slot />
  <Sidebar />
  <Footer />
</BaseLayout>

<script>
  import 'htmx.org'
  import '~/components/scripts/alpine'
</script>

<style is:global>
  @view-transition {
    navigation: auto; /* experimental: view transition */
  }

  [x-cloak] {
    display: none !important;
  }
</style>
