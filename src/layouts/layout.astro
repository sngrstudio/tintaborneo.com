---
import BaseLayout from './base.astro'
import SEO, { type Props as SEOProps } from './seo.astro'

interface Props extends SEOProps {}

const { title, description } = Astro.props
---

<BaseLayout class='min-h-screen pt-[64px] md:pt-[96px]'>
  {/* <head /> */}
  <Fragment slot='head'>
    <SEO title={title} description={description} />
    <slot name='head' />
  </Fragment>

  {/* <body /> */}
  <header
    class='w-full h-[64px] md:h-[96px]'
    hx-get='/parts/header'
    hx-trigger='load'
    hx-swap='outerHTML'
    hx-boost='true'
  >
  </header>
  <slot />
</BaseLayout>

<script>
  import 'htmx.org'
</script>

<style is:global>
  [x-cloak] {
    display: none !important;
  }
</style>
