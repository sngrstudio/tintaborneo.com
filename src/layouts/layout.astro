---
import BaseLayout from './base.astro'
import SEO, { type Props as SEOProps } from './seo.astro'
import Header from '~/components/header/header.astro'
import Sidebar from '~/components/sidebar/sidebar.astro'
import Footer from '~/components/footer/loader.astro'
import '@fontsource/source-serif-pro/400.css'
import '@fontsource/source-serif-pro/700.css'
import '@fontsource/source-serif-pro/900.css'
import '@fontsource/martel-sans/400.css'
import '@fontsource/martel-sans/700.css'

export interface Props extends SEOProps {}

const { title, description } = Astro.props
---

<BaseLayout class='bg-tb-background text-tb-text min-h-screen'>
  {/* <Head /> */}
  <Fragment slot='head'>
    <SEO title={title} description={description} />
    <slot name='head' />
  </Fragment>

  {/* <Body /> */}
  <Header />
  <slot />
  <Sidebar />
  <Footer />
</BaseLayout>

<script>
  import 'htmx.org'
</script>

<style is:global>
  @view-transition {
    navigation: auto; /* experimental: view transition */
  }

  [x-cloak] {
    display: none !important;
  }
</style>
