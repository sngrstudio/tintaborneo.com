---
import BaseLayout from './base.astro'
import SEO, { type Props as SEOProps } from './seo.astro'
import Header from '~/components/header/header.astro'
import '@fontsource/source-serif-pro/400.css'
import '@fontsource/source-serif-pro/700.css'
import '@fontsource/source-serif-pro/900.css'
import '@fontsource/martel-sans/400.css'
import '@fontsource/martel-sans/700.css'

export interface Props extends SEOProps {}

const { title, description } = Astro.props
---

<BaseLayout class='min-h-screen'>
  {/* <head /> */}
  <Fragment slot='head'>
    <SEO title={title} description={description} />
    <slot name='head' />
  </Fragment>

  {/* <body /> */}
  <Header />
  <slot />
  <footer
    class='h-[210px]'
    hx-get='/parts/footer'
    hx-trigger='revealed'
    hx-swap='outerHTML'
  >
  </footer>
</BaseLayout>

<script>
  import 'htmx.org'
</script>

<style is:global>
  [x-cloak] {
    display: none !important;
  }
</style>
