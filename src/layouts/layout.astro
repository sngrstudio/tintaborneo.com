---
import BaseLayout from './base.astro'
import SEO, { type Props as SEOProps } from './seo.astro'

interface Props extends SEOProps {}

const { title, description } = Astro.props
---

<BaseLayout>
  {/* <head /> */}
  <Fragment slot='head'>
    <SEO title={title} description={description} />
    <slot name='head' />
  </Fragment>

  {/* <body /> */}
  <header
    class='h-[56px]'
    hx-get='/parts/header'
    hx-trigger='load'
    hx-swap='outerHTML'
  >
  </header>
  <slot />
</BaseLayout>

<script>
  import 'htmx.org'
</script>
