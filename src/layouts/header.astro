---
import type { MenuItem } from '~/data/graphql'
import Alert from '~/components/alert.astro'
import { fetchLogo } from '~/data/site'
import { fetchMenuList } from '~/data/menu'
import { Picture } from 'astro:assets'
import MenuIcon from '~icons/material-symbols/menu'
import SearchIcon from '~icons/material-symbols/search'

interface Props {
  title: string
}

const { title } = Astro.props

const {
  data: { mediaItem: logo },
} = await fetchLogo('logo')
const {
  data: { menu: menuData },
} = await fetchMenuList('primary-menu')
const menu = menuData?.menuItems?.nodes
---

<header
  class="fixed top-0 inset-x-0 flex flex-col items-stretch bg-tb-background z-[9999] px-4 py-2 md:gap-y-2">
  <Alert message="Ini adalah tampilan ujicoba dan belum dirilis ke publik." />
  <div class="flex items-center justify-between">
    {/* menu button/current date */}
    <div>
      <button>
        <MenuIcon />
      </button>
    </div>

    {/* logo */}
    <div>
      <a href="/" role="button">
        <Picture
          class="object-contain w-[175px] h-[35px]"
          src={logo?.sourceUrl!}
          width={350}
          height={70}
          alt={title}
          formats={['avif', 'webp']}
          loading="eager"
        />
      </a>
    </div>

    {/* search button */}
    <div>
      <button>
        <SearchIcon />
      </button>
    </div>
  </div>
  <nav>
    <ul
      class:list={[
        'hidden font-subheading font-bold md:flex md:justify-center md:gap-x-3 md:gap-y-0',
        { 'text-tb-primary': Astro.url.pathname === '/' },
        { 'text-tb-muted': Astro.url.pathname !== '/' },
      ]}>
      {
        menu?.map((entry: MenuItem) => (
          <li
            class:list={[
              'hover:underline',
              { 'text-tb-primary': entry.uri === Astro.url.pathname },
            ]}>
            <a href={entry.uri}>{entry.label}</a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>
