---
interface Props {
  title: string
  type?: 'primary' | 'secondary'
}

const { title, type = 'secondary' } = Astro.props
---

<hgroup
  class:list={[
    'border-t-2 px-4 py-2',
    { 'border-tb-primary': type === 'primary' },
    { 'border-tb-muted': type === 'secondary' },
  ]}>
  <h1
    class:list={[
      'font-heading font-bold',
      { 'text-4xl text-tb-primary': type === 'primary' },
      { 'text-3xl text-tb-muted': type === 'secondary' },
    ]}>
    {title}
  </h1>
</hgroup>
