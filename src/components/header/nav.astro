---
import { MenuLocationEnum } from '~/data/graphql'
import { getMenu } from '~/data/menu'

const menu = await getMenu(MenuLocationEnum.PrimaryNavigation)
---

<nav
  class='px-4 overflow-x-auto [&::-webkit-scrollbar]:hidden [-ms-overflow-style:none] [scrollbar-width:none]'
>
  <ul
    class:list={[
      'hidden font-subheading font-bold md:flex md:justify-start lg:justify-center md:gap-x-3 md:gap-y-0',
      { 'text-tb-primary': Astro.url.pathname === '/' },
      { 'text-tb-muted': Astro.url.pathname !== '/' }
    ]}
    hx-boost='true'
  >
    {
      menu?.map((entry) => (
        <li
          class:list={[
            'hover:underline',
            { 'text-tb-primary': entry.uri === Astro.url.pathname }
          ]}
        >
          <a href={entry.uri}>{entry.label}</a>
        </li>
      ))
    }
  </ul>
</nav>
