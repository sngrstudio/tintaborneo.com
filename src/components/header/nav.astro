---
import { getMenu } from '~/data/site'
import { MenuLocationEnum } from '~/graphql/types'

const menu = await getMenu(MenuLocationEnum.PrimaryNavigation)
---

<nav class='z-[9996]'>
  <ul
    class='flex justify-start gap-2 overflow-x-scroll px-4 py-1 font-subheading font-bold text-tb-primary [-ms-overflow-style:none] [scrollbar-width:none] md:justify-center [&::-webkit-scrollbar]:hidden'
  >
    {
      menu.map((item) => (
        <li>
          <a href={item.uri} data-astro-prefetch>
            {item.label}
          </a>
        </li>
      ))
    }
  </ul>
</nav>
