---
import { Picture } from 'astro:assets'
import { getLogo } from '~/data/site'
import MenuIcon from '~icons/material-symbols/menu'
import SearchIcon from '~icons/material-symbols/search'

const logo = await getLogo('logo')
---

<div>
  <ul class='flex flex-row justify-between items-center px-4 mb-1'>
    <li>
      <button
        aria-label='Buka Menu'
        x-on:click="$dispatch('setsidebaropen', true); $dispatch('setsidebarmenu', 'menu')"
        x-data
      >
        <MenuIcon />
      </button>
    </li>
    <li>
      <a href='/' role='button' aria-label='Home'>
        <Picture
          class='object-contain w-[200px] h-auto'
          src={logo.sourceUrl!}
          formats={['avif', 'webp']}
          widths={[400]}
          inferSize
          sizes='400px'
          loading='eager'
          alt='Home'
        />
      </a>
    </li>
    <li>
      <button
        aria-label='Buka Pencarian'
        x-on:click="$dispatch('setsidebaropen', true); $dispatch('setsidebarmenu', 'search')"
        x-data
      >
        <SearchIcon />
      </button>
    </li>
  </ul>
</div>
