---
import { Picture } from 'astro:assets'
import { getLogo } from '~/data/site'
import MenuIcon from '~icons/material-symbols/menu'
import SearchIcon from '~icons/material-symbols/search'

const logo = await getLogo('logo')
---

<nav>
  <ul class='flex flex-row justify-between items-center px-4 mb-1'>
    <li>
      <button>
        <MenuIcon />
      </button>
    </li>
    <li>
      <a href='/' role='button' aria-label='Home'>
        <Picture
          class='object-contain w-[200px] h-auto'
          src={logo.sourceUrl!}
          widths={[400]}
          inferSize
          sizes='400px'
          loading='eager'
          alt='Home'
        />
      </a>
    </li>
    <li>
      <button>
        <SearchIcon />
      </button>
    </li>
  </ul>
</nav>
