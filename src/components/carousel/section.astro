<section
  class='mx-auto grid w-full max-w-screen-lg items-stretch gap-2 md:grid-cols-3'
>
  <slot />
</section>

<script>
  import Carousel from 'embla-carousel'
  import Autoplay from 'embla-carousel-autoplay'

  const featuredPostNode = document.querySelector(
    '.__featured_posts_carousel'
  ) as HTMLElement
  const latestPostNode = document.querySelector(
    '.__latest_posts_carousel'
  ) as HTMLElement

  Carousel(featuredPostNode, { loop: true }, [Autoplay({ delay: 7700 })])
  Carousel(latestPostNode, { loop: true }, [Autoplay({ delay: 5500 })])
</script>
