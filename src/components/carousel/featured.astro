---
import type { Post } from '~/graphql/types'
import type { HTMLAttributes } from 'astro/types'
import { Picture } from 'astro:assets'
import { getDateString } from '~/utils/date'

interface Props extends HTMLAttributes<'div'> {
  posts: Array<Post>
}

const { posts, class: className } = Astro.props
---

<div
  class:list={[
    '__featured_posts_carousel aspect-[4/3] overflow-hidden md:aspect-auto',
    className
  ]}
>
  <div class='flex h-full'>
    {
      posts.map((post) => (
        <a
          class='relative mr-2 min-w-0 flex-[0_0_100%] overflow-hidden rounded-xl bg-tb-muted'
          href={post.uri}
          data-astro-prefetch
        >
          {post.featuredImage && (
            <Picture
              class='aspect-[4/3] w-full object-cover'
              src={post.featuredImage.node.sourceUrl!}
              formats={['avif', 'webp']}
              widths={[677]}
              width={400}
              height={300}
              loading='eager'
              alt={post.title || ''}
            />
          )}
          <div class='absolute inset-0 flex flex-col justify-end gap-1 bg-gradient-to-t from-tb-text to-tb-text/[.0] px-4 pb-6 text-tb-background'>
            <span class='font-subheading text-sm font-bold uppercase md:text-base'>
              Berita Utama
            </span>
            <h3 class='line-clamp-3 font-heading text-xl font-bold leading-tight md:text-3xl'>
              {post.title}
            </h3>
            <p class='text-sm italic'>
              <time datetime={post.date}>{getDateString(post.date!)}</time>
            </p>
          </div>
        </a>
      ))
    }
  </div>
</div>
