---
import { MenuLocationEnum } from '~/graphql/types'
import { getMenu } from '~/data/site'

const menu = await getMenu(MenuLocationEnum.FooterLinks)
---

<div>
  <ul class='flex flex-wrap justify-center gap-x-2 text-sm'>
    {
      menu.map((entry) => (
        <li class='hover:underline'>
          <a href={entry.uri}>{entry.label}</a>
        </li>
      ))
    }
  </ul>
</div>
