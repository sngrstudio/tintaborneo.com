---
import { Picture } from 'astro:assets'
import { getLogo } from '~/data/site'

const logo = await getLogo('logo-alt-v2')
---

<div class='flex items-center justify-center'>
  <Picture
    class='h-[50px] w-[250px] object-contain'
    src={logo.sourceUrl!}
    width={500}
    height={100}
    alt={logo.altText!}
    formats={['avif', 'webp']}
  />
</div>
