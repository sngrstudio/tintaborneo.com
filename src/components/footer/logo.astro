---
import { Picture } from 'astro:assets'
import { getLogo } from '~/data/site'

const logo = await getLogo('logo-alt')
---

<div class='flex items-center justify-center'>
  <Picture
    class='object-contain w-[250px] h-[50px]'
    src={logo.sourceUrl!}
    width={500}
    height={100}
    alt={logo.altText!}
    formats={['avif', 'webp']}
  />
</div>
