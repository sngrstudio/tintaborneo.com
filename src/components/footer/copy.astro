---
const copyTexts = [
  `<b>&copy; ${new Date().getFullYear()} PT Multimedia Jagad Perkasa.</b>`,
  `Hak cipta dilindungi oleh undang-undang.`,
  `Didesain & dikembangkan oleh <a class="underline" href="https://sngr.my.id" rel="sponsored">SNGR Studio</a>.`
]
---

<div>
  <ul class='flex flex-wrap justify-center gap-x-2 text-sm text-center'>
    {
      copyTexts.map((entry) => (
        <li>
          <span set:html={entry} />
        </li>
      ))
    }
  </ul>
</div>
