---
interface Props {
  uri: string
}

const { uri } = Astro.props
---

<section
  class='max-w-screen-lg mx-auto w-full'
  hx-get={uri}
  hx-swap='outerHTML'
  hx-trigger='revealed'
>
  <div class='h-[42px] bg-tb-muted/20 rounded animate-pulse mb-4'></div>
  <div
    class='grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-2 sm:gap-y-6 w-full'
  >
    {
      Array.from({ length: 8 }, () => (
        <div class='flex sm:flex-col gap-2 w-full'>
          <div class='shrink-0 sm:shrink aspect-[4/3] bg-tb-muted/20 rounded-xl animate-pulse w-[160px] sm:w-full h-full' />
          <div class='flex-1 flex flex-col gap-1 justify-start w-full'>
            {Array.from({ length: 2 }, () => (
              <div class='h-[24px] w-full bg-tb-muted/20 rounded animate-pulse' />
            ))}
            <div class='h-[12px] w-full bg-tb-muted/20 rounded animate-pulse mt-auto sm:mt-4' />
          </div>
        </div>
      ))
    }
  </div>
</section>
