---
import type { Post } from '~/graphql/types'
import ListCard from './card.astro'

interface Props {
  posts: Array<Post>
}

const { posts } = Astro.props
---

<ul
  class='mb-2 grid grid-cols-1 gap-2 sm:mb-6 sm:grid-cols-2 sm:gap-y-6 md:grid-cols-4'
>
  {posts.map((post) => <ListCard post={post} />)}
</ul>
