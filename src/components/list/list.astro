---
import type { Post } from '~/graphql/types'
import ListCard from './card.astro'

interface Props {
  posts: Array<Post>
}

const { posts } = Astro.props
---

<ul
  class='grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-2 sm:gap-y-6'
  hx-boost='true'
>
  {posts.map((post) => <ListCard post={post} />)}
</ul>
