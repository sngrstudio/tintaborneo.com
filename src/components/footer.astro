---
import { type MenuItem, MenuLocationEnum } from '~/data/graphql'
import { getLogo } from '~/data/site'
import { Picture } from 'astro:assets'
import { getMenu } from '~/data/menu'

const {
  data: { mediaItem: logo }
} = await getLogo('logo-alt')
const {
  data: { menuItems }
} = await getMenu(MenuLocationEnum.FooterLinks)

const secondaryMenu = menuItems?.nodes
const copyTexts = [
  `<b>&copy; ${new Date().getFullYear()} PT Multimedia Jagad Perkasa.</b>`,
  `Hak cipta dilindungi oleh undang-undang.`,
  `Didesain & dikembangkan oleh <a class="underline" href="https://sngr.my.id" rel="sponsored">SNGR Studio</a>.`
]
---

<footer
  class='flex flex-col items-center gap-4 bg-tb-secondary text-tb-background px-4 pt-4 pb-8 mt-16'
>
  <div class='flex items-center justify-center'>
    <Picture
      class='object-contain w-[250px] h-[50px]'
      src={logo?.sourceUrl!}
      width={500}
      height={100}
      alt={logo?.altText!}
      formats={['avif', 'webp']}
    />
  </div>
  <div>
    <ul class='flex justify-center flex-wrap gap-x-2 text-sm'>
      {
        secondaryMenu?.map((entry: MenuItem) => (
          <li class='hover:underline'>
            <a href={entry.uri}>{entry.label}</a>
          </li>
        ))
      }
    </ul>
  </div>
  <div>
    <ul class='flex flex-wrap justify-center gap-x-2 text-sm text-center'>
      {
        copyTexts.map((entry) => (
          <li>
            <span set:html={entry} />
          </li>
        ))
      }
    </ul>
  </div>
</footer>
