---
import type { Post } from '~/graphql/types'
import Picture from 'astro/components/Picture.astro'
import { getDateString } from '~/utils/date'
import type { HTMLAttributes } from 'astro/types'

interface Props extends HTMLAttributes<'li'> {
  post: Post
}

const { post, ...attrs } = Astro.props
---

<li class='flex gap-2' {...attrs}>
  <a
    class='shrink-0 w-[120px] aspect-[4/3] bg-tb-background/20 rounded-xl overflow-hidden'
    href={post.uri}
    data-astro-prefetch
  >
    {
      post.featuredImage && (
        <Picture
          class='object-cover w-full h-full'
          src={post.featuredImage.node.sourceUrl!}
          formats={['avif', 'webp']}
          width={400}
          height={300}
          widths={[120]}
          sizes='120px'
          alt={post.title || ''}
        />
      )
    }
  </a>

  <div class='flex-1 flex flex-col justify-between'>
    <a
      class='font-heading font-bold line-clamp-3 text-sm'
      href={post.uri}
      data-astro-prefetch
    >
      {post.title}
    </a>
    <time class='text-sm' datetime={post.date}>
      {getDateString(new Date(post.date!))}
    </time>
  </div>
</li>
