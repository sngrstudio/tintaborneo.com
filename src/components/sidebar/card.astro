---
import type { Post } from '~/graphql/types'
import Picture from 'astro/components/Picture.astro'
import { getDateString } from '~/utils/date'
import type { HTMLAttributes } from 'astro/types'

interface Props extends HTMLAttributes<'li'> {
  post: Post
}

const { post, ...attrs } = Astro.props
---

<li class='flex gap-2' {...attrs}>
  <a
    class='aspect-[4/3] w-[120px] shrink-0 overflow-hidden rounded-xl bg-tb-background/20'
    href={post.uri}
    data-astro-prefetch
  >
    {
      post.featuredImage && (
        <Picture
          class='h-full w-full object-cover'
          src={post.featuredImage.node.sourceUrl!}
          formats={['avif', 'webp']}
          width={400}
          height={300}
          widths={[120]}
          sizes='120px'
          alt={post.title || ''}
        />
      )
    }
  </a>

  <div class='flex flex-1 flex-col justify-between'>
    <a
      class='line-clamp-3 font-heading text-sm font-bold'
      href={post.uri}
      data-astro-prefetch
    >
      {post.title}
    </a>
    <time class='text-sm' datetime={post.date}>
      {getDateString(post.date!)}
    </time>
  </div>
</li>
