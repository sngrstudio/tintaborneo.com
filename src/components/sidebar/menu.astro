---
import { getMenu } from '~/data/site'
import { MenuLocationEnum, type MenuItem } from '~/graphql/types'

const menu = await getMenu(MenuLocationEnum.SidebarNavigation).then((res) =>
  res.filter((i) => !i.parentId)
)
---

<template x-if="type==='menu'">
  <div
    class='flex h-full flex-1 flex-col overflow-y-scroll [-ms-overflow-style:none] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden'
  >
    <ul class='mb-8 flex flex-1 flex-col gap-2 md:gap-2'>
      {
        menu.map((entry) => (
          <li class='w-max font-subheading text-xl font-bold md:text-2xl'>
            <a href={entry.uri} x-on:click='isOpen=false' data-astro-prefetch>
              {entry.label}
            </a>
            {entry.childItems && entry.childItems?.nodes.length! > 0 && (
              <ul class='ml-4 flex flex-col gap-1'>
                {entry.childItems.nodes.map((child: MenuItem) => (
                  <li class='font-subheading text-lg font-normal md:text-xl'>
                    <a
                      href={child.uri}
                      x-on:click='isOpen=false'
                      data-astro-prefetch
                    >
                      {child.label}
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))
      }
    </ul>
  </div>
</template>
