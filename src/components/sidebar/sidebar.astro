---
import SidebarMenu from './menu.astro'
import SidebarSearch from './search.astro'
import CloseIcon from '~icons/material-symbols/close'
---

<aside
  class="fixed inset-y-0 left-0 right-0 z-[9999] flex flex-col gap-8 bg-tb-background px-4 pt-2 pb-8 md:w-1/3 md:border-tb-primary md:shadow"
  x-data="{isOpen: false, type: ''}"
  x-bind:class="{'md:right-auto md:border-r-2': type==='menu', 'md:left-auto md:border-l-2': type==='search'}"
  x-on:setsidebaropen.window="isOpen=$event.detail"
  x-on:setsidebarmenu.window="type=$event.detail"
  x-on:click.outside="isOpen=false"
  x-show="isOpen"
  x-cloak>
  {/* close button */}
  <div
    class="flex py-3"
    x-bind:class="{'justify-start': type==='menu', 'justify-end': type==='search'}">
    <div>
      <button x-on:click="isOpen=false">
        <CloseIcon />
      </button>
    </div>
  </div>

  {/* sidebar components */}
  <SidebarMenu />
  <SidebarSearch />
</aside>
