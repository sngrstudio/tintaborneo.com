---
import SidebarMenu from './menu.astro'
import SidebarSearch from './search.astro'
import CloseIcon from '~icons/material-symbols/close'
---

<aside
  class='fixed inset-0 flex z-[9999] bg-[#00000030]'
  x-data="{isOpen: false, type: 'search'}"
  x-bind:class="{'justify-start': type==='menu', 'justify-end': type==='search'}"
  x-on:setsidebaropen.window='isOpen=$event.detail'
  x-on:setsidebarmenu.window='type=$event.detail'
  x-transition:enter='transition-colors ease-out duration-300'
  x-transition:enter-start='bg-[#00000000]'
  x-transition:enter-end='bg-[#00000030]'
  x-transition:leave='transition-colors ease-in duration-300'
  x-transition:leave-start='bg-[#00000030]'
  x-transition:leave-end='bg-[#00000000]'
  x-show='isOpen'
  x-cloak
>
  <div
    class='flex flex-col gap-8 bg-tb-muted text-tb-background w-4/5 md:w-1/3 lg:w-1/4 h-full px-4 pt-2'
    x-on:click.outside='isOpen=false'
    x-bind:style="type==='menu' ? { '--tb-translate-value':'-100%' } : type==='search' ? { '--tb-translate-value':'100%' } : ''"
    x-transition:enter='transition-transform ease-out duration-200'
    x-transition:enter-start='translate-x-[--tb-translate-value]'
    x-transition:enter-end='translate-x-0'
    x-transition:leave='transition-transform ease-in duration-200'
    x-transition:leave-start='translate-x-0'
    x-transition:leave-end='translate-x-[--tb-translate-value]'
    x-show='isOpen'
    x-cloak
  >
    {/* close button */}
    <div
      class='flex py-3'
      x-bind:class="{'justify-start': type==='menu', 'justify-end': type==='search'}"
    >
      <div>
        <button x-on:click='isOpen=false'>
          <CloseIcon />
        </button>
      </div>
    </div>

    {/* sidebar components */}
    <SidebarMenu />
    <SidebarSearch />
  </div>
</aside>
