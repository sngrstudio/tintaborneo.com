<template x-if="type==='search'">
  <div
    class='flex h-full flex-1 flex-col gap-8 overflow-hidden pb-8'
    x-data="{ q: '' }"
  >
    <form
      class='flex w-full border-b-2 text-lg focus-within:border-tb-background'
      x-on:submit.prevent='console.log(q)'
    >
      <input
        name='q'
        class='flex-1 bg-[transparent] text-tb-background outline-none'
        type='search'
        placeholder='Cari di TintaBorneo.com'
        x-model='q'
        x-bind:hx-get="'/parts/search?' + q"
        hx-trigger='input changed delay:400ms'
        hx-target='#search-result'
      />
    </form>

    <ul
      id='search-result'
      class='flex h-full flex-1 flex-col gap-2 overflow-y-scroll [-ms-overflow-style:none] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden'
      x-show="q!==''"
      x-cloak
    >
    </ul>
  </div>
</template>
