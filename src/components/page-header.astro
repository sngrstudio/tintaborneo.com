---
interface Props {
  title: string
  type?: 'primary' | 'secondary'
}

const { title, type = 'secondary' } = Astro.props
---

<hgroup
  class:list={[
    'border-t-2 py-2 mb-4',
    { 'border-tb-primary': type === 'primary' },
    { 'border-tb-muted': type === 'secondary' }
  ]}
>
  <h1
    class:list={[
      'font-heading max-w-screen-lg mx-auto px-4',
      { 'font-black text-4xl text-tb-primary md:text-5xl': type === 'primary' },
      { 'font-bold text-3xl text-tb-muted': type === 'secondary' }
    ]}
  >
    {title}
  </h1>
</hgroup>
