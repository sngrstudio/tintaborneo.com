---
export interface Props {
  title?: string
  uri?: string
  type?: 'primary' | 'secondary'
  withHeader?: boolean
  singleRow?: boolean
}

const { title, uri, type, withHeader, singleRow } = Astro.props
---

<section
  class:list={[
    'grid grid-cols-1 gap-3 content-start px-4',
    { 'md:grid-cols-4 md:gap-4': !singleRow },
  ]}>
  {
    withHeader && (
      <hgroup
        class:list={[
          'border-t-2 px-4 py-1 -mx-4',
          { 'border-tb-primary': type === 'primary' },
          { 'border-tb-muted': type === 'secondary' },
          { 'md:col-span-4 md:py-3': !singleRow },
        ]}>
        <h2
          class:list={[
            'font-heading font-bold',
            { 'text-tb-primary text-3xl md:text-4xl': type === 'primary' },
            { 'text-tb-muted text-2xl': type === 'secondary' },
          ]}>
          <a href={uri}>{title}</a>
        </h2>
      </hgroup>
    )
  }
  <slot />
</section>
