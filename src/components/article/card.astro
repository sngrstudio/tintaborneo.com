---
import type { Post } from '~/data/graphql'
import { Picture } from 'astro:assets'
import { getDateString } from '~/utils/date'

interface Props {
  post: Post
  type?: 'spotlight' | 'normal'
  loadImage?: 'lazy' | 'eager'
}

const { post, type = 'normal', loadImage = 'lazy' } = Astro.props
---

<article
  class:list={[
    'flex gap-2 font-heading',
    { 'flex-col': type === 'spotlight' },
    { 'flex-row': type === 'normal' },
  ]}>
  <div
    class:list={[
      'flex aspect-[128/96]',
      { 'w-full h-auto': type === 'spotlight' },
      { 'w-[128px] h-[96px]': type === 'normal' },
    ]}>
    <a class:list={[{ 'flex-1 -mx-4': type === 'spotlight' }]} href={post.uri}>
      <Picture
        class:list={[
          'object-cover object-center',
          { 'w-full h-full': type === 'spotlight' },
          { 'w-[128px] h-[96px]': type === 'normal' },
        ]}
        src={post.featuredImage?.node.sourceUrl!}
        width={type === 'spotlight' ? 256 : 512}
        height={type === 'spotlight' ? 192 : 384}
        alt={post.featuredImage?.node.altText || post.title!}
        loading={loadImage}
      />
    </a>
  </div>
  <div
    class:list={[
      'flex flex-col justify-between [&>p]:line-clamp-4',
      { 'gap-2': type === 'spotlight' },
      { 'gap-1': type !== 'spotlight' },
    ]}>
    <h3 class:list={['font-bold', { 'text-xl': type === 'spotlight' }]}>
      <a href={post.uri}>{post.title}</a>
    </h3>
    {type === 'spotlight' && <Fragment set:html={post.excerpt} />}
    <p class="font-sans text-sm">
      <time datetime={post.date}>
        {getDateString(new Date(post.date!))}
      </time>
    </p>
  </div>
</article>
