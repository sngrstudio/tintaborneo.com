---
import type { Post } from '~/data/graphql'
import type { PostWithOptimizedImage } from '../home/type'
import { Picture } from 'astro:assets'
import { getDateString } from '~/utils/date'

export interface Props {
  post: Post | PostWithOptimizedImage
  type?: 'spotlight' | 'normal' | 'list'
  loadImage?: 'lazy' | 'eager'
}

const { post, type = 'normal', loadImage = 'lazy' } = Astro.props
---

<article
  class:list={[
    'grid content-start font-heading',
    {
      'grid-cols-1 gap-y-2 items-start md:col-span-3 md:grid-cols-2 md:gap-x-2':
        type === 'spotlight'
    },
    {
      'grid-cols-3 gap-x-2': type === 'normal' || type === 'list'
    },
    {
      'md:grid-cols-1 md:gap-y-2 md:gap-x-0': type === 'normal'
    }
  ]}
>
  {
    post.featuredImage && (
      <div
        class:list={[
          'flex h-max w-full rounded-lg overflow-hidden',
          { 'md:order-[2]': type === 'spotlight' }
        ]}
      >
        <a
          class:list={[
            'w-full h-max',
            { 'flex-1 -mx-4 md:mx-0': type === 'spotlight' }
          ]}
          href={post.uri}
        >
          <Picture
            class:list='flex-1 aspect-[4/3] object-cover object-center w-full h-auto'
            src={post.featuredImage?.node.sourceUrl!}
            width={236}
            height={177}
            alt={post.featuredImage?.node.altText || post.title!}
            widths={[128, 172, 236]}
            sizes='(max-width: 640px) 128px, (max-width: 768px) 172px, 236px'
            formats={['avif', 'webp']}
            loading={loadImage}
          />
        </a>
      </div>
    )
  }
  <div
    class:list={[
      'flex-1 flex flex-col justify-between',
      { 'col-span-2': !!post.featuredImage },
      { 'col-span-3': !post.featuredImage },
      {
        'gap-2 [&>p:not(.tb-time)]:line-clamp-4 md:col-span-1 md:gap-4 md:justify-center md:order-[1]':
          type === 'spotlight'
      },
      {
        'gap-1 md:justify-start [&>p:not(.tb-time)]:hidden [&>p:not(.tb-time)]:line-clamp-3 md:[&>p:not(.tb-time)]:[display:-webkit-box]':
          type === 'normal'
      },
      {
        'gap-1 md:justify-start [&>p:not(.tb-time)]:hidden [&>p:not(.tb-time)]:line-clamp-3 md:[&>p:not(.tb-time)]:[display:-webkit-box]':
          type === 'list'
      }
    ]}
  >
    <h3
      class:list={[
        'font-bold',
        { 'text-xl md:text-2xl': type === 'spotlight' },
        { 'text-base md:text-lg': type === 'normal' },
        { 'text-base md:text-xl': type === 'list' }
      ]}
    >
      <a href={post.uri}>
        {post.title}
      </a>
    </h3>
    <Fragment set:html={post.excerpt} />
    <p class='tb-time font-sans text-sm md:mt-auto'>
      <time datetime={post.date + '+07:00'}>
        {getDateString(new Date(post.date! + '+07:00'))}
      </time>
    </p>
  </div>
</article>
