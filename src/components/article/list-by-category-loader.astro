---
import LoadingIndicator from '~/components/loading-indicator.astro'

interface Props {
  id: string
  isPrimary?: boolean
  withHeader?: boolean
  lazyload?: boolean
  loadImageEagerly?: boolean
}

const {
  id,
  isPrimary,
  withHeader = true,
  lazyload = true,
  loadImageEagerly = false,
} = Astro.props
---

<div
  class="flex flex-col items-center justify-start h-[100vh] pt-24"
  hx-get={`/parts/category/?id=${id}${withHeader ? '&header=true' : ''}${isPrimary ? '&primary=true' : ''}${loadImageEagerly ? '&loadImageEagerly=true' : ''}`}
  hx-trigger={lazyload ? 'revealed' : 'load'}
  hx-swap="outerHTML">
  <LoadingIndicator />
</div>
