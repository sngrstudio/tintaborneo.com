---
import ArticleSection, {
  type Props as ArticleSectionProps,
} from './section.astro'
import ArticleList, { type Props as ArticleListProps } from './list.astro'
import { fetchCategory } from '~/data/taxonomies'
import { fetchPosts } from '~/data/posts'

interface Props
  extends Pick<ArticleSectionProps, 'type' | 'withHeader'>,
    Pick<ArticleListProps, 'loadImage'> {
  categoryId: string
  amount?: number
}

const {
  categoryId,
  amount = 6,
  type,
  withHeader = false,
  loadImage = 'lazy',
} = Astro.props

const {
  data: { category },
} = await fetchCategory(categoryId)
const {
  data: { posts },
} = await fetchPosts({
  amount,
  category: categoryId,
})
---

<ArticleSection
  title={category?.name!}
  uri={category?.uri!}
  type={type}
  withHeader={withHeader}>
  <ArticleList posts={posts?.nodes!} type="spotlight" loadImage={loadImage} />
</ArticleSection>
