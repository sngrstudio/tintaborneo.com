---
import ArticleSection, {
  type Props as ArticleSectionProps,
} from './section.astro'
import ArticleList from './list.astro'
import { fetchCategory } from '~/data/taxonomies'
import { fetchPosts } from '~/data/posts'

interface Props extends Pick<ArticleSectionProps, 'type' | 'withHeader'> {
  categoryId: string
  amount?: number
  loadImageEagerly?: boolean
}

const {
  categoryId,
  amount = 6,
  type,
  withHeader = false,
  loadImageEagerly = false,
} = Astro.props

const {
  data: { category },
} = await fetchCategory(categoryId)
const {
  data: { posts },
} = await fetchPosts({
  amount,
  category: categoryId,
})
---

<ArticleSection
  title={category?.name!}
  uri={category?.uri!}
  type={type}
  withHeader={withHeader}>
  <ArticleList
    posts={posts?.nodes!}
    loadImageEagerly={loadImageEagerly}
    expandSpotlight
  />
</ArticleSection>
