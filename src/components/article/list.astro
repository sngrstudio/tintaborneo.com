---
import type { Post } from '~/data/graphql'
import ArticleCard from '~/components/article/card.astro'
import Separator from '../separator.astro'

interface Props {
  posts: Array<Post>
  expandSpotlight?: boolean
  loadImageEagerly?: boolean
}

const { posts, expandSpotlight = false, loadImageEagerly = false } = Astro.props
---

<Fragment>
  {
    posts.map((post: Post, i, arr) => (
      <Fragment>
        <ArticleCard
          post={post}
          type={expandSpotlight && i === 0 ? 'spotlight' : 'normal'}
          loadImage={loadImageEagerly ? 'eager' : 'lazy'}
        />
        {i < arr.length - 1 && <Separator />}
      </Fragment>
    ))
  }
</Fragment>
