---
import type { Post } from '~/data/graphql'
import ArticleCard, {
  type Props as ArticleCardProps,
} from '~/components/article/card.astro'
import Separator from '../separator.astro'

export interface Props extends Pick<ArticleCardProps, 'loadImage'> {
  posts: Array<Post>
  type?: 'spotlight' | 'list'
}

const { posts, type = 'list', loadImage = 'lazy' } = Astro.props
---

<Fragment>
  {
    posts.map((post: Post, i, arr) => (
      <Fragment>
        <ArticleCard
          post={post}
          type={
            type === 'spotlight' && i === 0
              ? 'spotlight'
              : type === 'list'
                ? 'list'
                : 'normal'
          }
          loadImage={loadImage}
        />{' '}
        {i < arr.length - 1 && <Separator class="md:hidden" />}
      </Fragment>
    ))
  }
</Fragment>
