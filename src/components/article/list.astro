---
import type { Post } from '~/data/graphql'
import type { PostWithOptimizedImage } from '../home/type'
import ArticleCard, {
  type Props as ArticleCardProps
} from '~/components/article/card.astro'

export interface Props extends Pick<ArticleCardProps, 'loadImage'> {
  posts: Array<Post | PostWithOptimizedImage>
  type?: 'spotlight' | 'list'
}

const { posts, type = 'list', loadImage = 'lazy' } = Astro.props
---

<Fragment>
  {
    posts.length > 0 &&
      posts.map((post: Post) => (
        <ArticleCard
          post={post}
          type={type === 'list' ? 'list' : 'normal'}
          loadImage={loadImage}
        />
      ))
  }
</Fragment>
