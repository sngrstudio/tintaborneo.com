---
import LoadingIcon from '~icons/eos-icons/three-dots-loading'

interface Props {
  uri: string
}

const { uri } = Astro.props
---

<div
  class="flex flex-col items-center justify-center h-[144px]"
  hx-get={uri}
  hx-trigger="revealed"
  hx-swap="outerHTML">
  <LoadingIcon class="w-[48px] h-[48px] text-tb-primary htmx-indicator" />
</div>
