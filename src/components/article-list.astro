---
import type { Post } from '~/data/graphql'
import ArticleCard from '~/components/article-card.astro'
import { fetchCategoryWithPosts } from '~/data/posts'

interface Props {
  id: string
}

const { id } = Astro.props
const {
  data: { category },
} = await fetchCategoryWithPosts(id)
---

<section class="flex flex-col gap-3 px-4">
  {
    category?.posts?.edges.map(({ node: post }: { node: Post }, i, arr) => (
      <Fragment>
        <ArticleCard post={post} />
        {i < arr.length - 1 ? <hr class="text-tb-muted" /> : null}
      </Fragment>
    ))
  }
</section>
