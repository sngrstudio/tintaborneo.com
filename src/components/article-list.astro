---
import type { Post } from '~/data/graphql'
import ArticleCard from '~/components/article-card.astro'
import { fetchPostsByCategory } from '~/data/posts'

interface Props {
  id: string
  type?: 'primary' | 'secondary'
  withHeader?: boolean
}

const { id, type = 'secondary', withHeader } = Astro.props
const {
  data: { posts, category },
} = await fetchPostsByCategory(id)
---

<section class="flex flex-col gap-3 px-4">
  {
    withHeader && (
      <hgroup
        class:list={[
          'border-t-2 px-4 py-1 -mx-4',
          { 'border-tb-primary': type === 'primary' },
          { 'border-tb-muted': type === 'secondary' },
        ]}>
        <h2
          class:list={[
            'font-heading font-bold',
            { 'text-tb-primary text-3xl': type === 'primary' },
            { 'text-tb-muted text-2xl': type === 'secondary' },
          ]}>
          <a href={category?.uri}>{category?.name}</a>
        </h2>
      </hgroup>
    )
  }
  {
    posts?.nodes.map((post: Post, i, arr) => (
      <Fragment>
        <ArticleCard post={post} />
        {i < arr.length - 1 ? <hr class="text-tb-muted" /> : null}
      </Fragment>
    ))
  }
</section>
