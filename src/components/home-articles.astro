---
import type { MenuItem } from '~/data/graphql'
import ArticleListByCategory from './article/list-by-category.astro'
import LoadingIndicator from './loading-indicator.astro'
import { fetchMenuList } from '~/data/menu'

const {
  data: { menu: menuData },
} = await fetchMenuList('home-category-list')
const menu = menuData?.menuItems?.nodes
---

<Fragment>
  <ArticleListByCategory categoryId="berita-utama" loadImageEagerly />
  {
    menu?.map((entry: MenuItem) => (
      <div
        class="flex flex-col items-center justify-center h-[144px]"
        hx-get={`/parts/category/?id=${entry.connectedObject?.slug}&primary=true`}
        hx-trigger="revealed"
        hx-swap="outerHTML">
        <LoadingIndicator />
      </div>
    ))
  }
</Fragment>
