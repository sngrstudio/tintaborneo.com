---
import type { MenuItem } from '~/data/graphql'
import ArticleListByCategoryLoader from './article/list-by-category-loader.astro'
import { fetchMenuList } from '~/data/menu'

const {
  data: { menu: menuData },
} = await fetchMenuList('home-category-list')
const menu = menuData?.menuItems?.nodes
---

<Fragment>
  <ArticleListByCategoryLoader
    id="berita-utama"
    lazyload={false}
    withHeader={false}
    loadImageEagerly
  />
  {
    menu?.map((entry: MenuItem) => (
      <ArticleListByCategoryLoader
        id={entry.connectedObject?.slug!}
        isPrimary
      />
    ))
  }
</Fragment>
