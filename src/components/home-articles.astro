---
import type { MenuItem } from '~/data/graphql'
import ArticleSection from './article/section.astro'
import ArticleList from './article/list.astro'
import ArticleListByCategoryLoader from './article/list-by-category-loader.astro'
import { fetchMenuList } from '~/data/menu'
import { fetchPosts } from '~/data/posts'

const {
  data: { menu: menuData },
} = await fetchMenuList('primary-navigation')
const menu = menuData?.menuItems?.nodes

const {
  data: { posts },
} = await fetchPosts({
  tag: 'berita-utama',
})
---

<Fragment>
  <ArticleSection>
    <ArticleList posts={posts?.nodes!} type="spotlight" loadImage="eager" />
  </ArticleSection>
  {
    menu?.map((entry: MenuItem) => (
      <ArticleListByCategoryLoader
        id={entry.connectedObject?.slug!}
        isPrimary
      />
    ))
  }
</Fragment>
