---
import type { Experimental_PostsData as PostsData } from './type'
import type { MenuItem } from '~/data/graphql'
import PrimaryCarousel from './carousel-component'
import SecondaryCarousel from './secondary-carousel-component'
import LoadingIndicator from '~/components/loading-indicator.astro'
import { getMenu } from '~/data/experimental_menu'

interface Props {
  featuredPosts: PostsData
  latestPosts: PostsData
}

const { featuredPosts, latestPosts } = Astro.props
const secondaryCarouselPosts = latestPosts.reduce(
  (result: Array<typeof latestPosts>, _, index) => {
    if (index % 4 === 0) {
      result.push(latestPosts.slice(index, index + 4))
    }
    return result
  },
  []
)
const {
  data: { menuItems }
} = await getMenu('PRIMARY_NAVIGATION')

const filteredNewsId = ([] as string[])
  .concat(featuredPosts.map((entry) => entry.id))
  .concat(latestPosts.map((entry) => entry.id))
  .join(',')
---

<section class='grid grid-cols-1 md:grid-cols-5 gap-2 px-4'>
  <PrimaryCarousel posts={featuredPosts} client:load />
  <SecondaryCarousel posts={secondaryCarouselPosts} client:load />
</section>

<Fragment>
  {
    menuItems?.nodes.map((item: MenuItem) => (
      // @ts-ignore
      <div
        class='flex flex-col items-center justify-start h-[100vh] pt-24'
        hx-get={`/parts/category/?categoryId=${item.connectedNode?.node.slug}&filter=${filteredNewsId}`}
        hx-trigger='revealed'
        hx-swap='outerHTML'
      >
        <LoadingIndicator />
      </div>
    ))
  }
</Fragment>
