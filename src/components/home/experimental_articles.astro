---
import type { Experimental_PostsData as PostsData } from './type'
import PrimaryCarousel from './carousel-component'
import SecondaryCarousel from './secondary-carousel-component'
import { Debug } from 'astro:components'

interface Props {
  featuredPosts: PostsData
  latestPosts: PostsData
}

const { featuredPosts, latestPosts } = Astro.props
const secondaryCarouselPosts = latestPosts.slice(8).reduce(
  (result: Array<typeof latestPosts>, _, index) => {
    if (index % 4 === 0) {
      result.push(latestPosts.slice(index, index + 4))
    }
    return result
  },
  []
)
---

<section class='grid grid-cols-1 md:grid-cols-5 gap-2 px-4'>
  <PrimaryCarousel posts={featuredPosts} client:load />
  <SecondaryCarousel posts={secondaryCarouselPosts} client:load />
</section>
<Debug {secondaryCarouselPosts} />