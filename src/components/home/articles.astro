---
import { type MenuItem, MenuLocationEnum } from '~/data/graphql'
import type { PostsData } from './type'
import ArticleCarousel from './carousel.astro'
import ArticleListByCategoryLoader from '../article/list-by-category-loader.astro'
import { getMenu } from '~/data/menu'

export interface Props extends PostsData {}

const { posts } = Astro.props

const {
  data: { menuItems }
} = await getMenu(MenuLocationEnum.PrimaryNavigation)
const menu = menuItems?.nodes
---

<ArticleCarousel posts={posts} />
<Fragment>
  {
    menu?.map((entry: MenuItem) => (
      // @ts-ignore
      <ArticleListByCategoryLoader
        id={entry.connectedNode?.node.slug}
        isPrimary
      />
    ))
  }
</Fragment>
