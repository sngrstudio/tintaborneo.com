---
import type { Post } from '~/graphql/types'
import type { HTMLAttributes } from 'astro/types'
import { Picture } from 'astro:assets'
import { getDateString } from '~/utils/date'

interface Props extends HTMLAttributes<'div'> {
  posts: Array<Post>
}

const { posts, class: className } = Astro.props
---

<div
  class:list={[
    '__featured_posts_carousel aspect-[4/3] md:aspect-auto overflow-hidden',
    className
  ]}
>
  <div class='flex h-full'>
    {
      posts.map((post) => (
        <a
          class='relative flex-[0_0_100%] min-w-0 rounded-xl overflow-hidden bg-tb-muted mr-2'
          href={post.uri}
          data-astro-prefetch
        >
          {post.featuredImage && (
            <Picture
              class='object-cover w-full aspect-[4/3]'
              src={post.featuredImage.node.sourceUrl!}
              formats={['avif', 'webp']}
              widths={[677]}
              width={400}
              height={300}
              loading='eager'
              alt={post.title || ''}
            />
          )}
          <div class='absolute inset-0 flex flex-col gap-1 justify-end bg-gradient-to-t from-tb-text to-tb-text/[.0] text-tb-background px-4 pb-6'>
            <span class='font-subheading font-bold uppercase text-sm md:text-base'>
              Berita Utama
            </span>
            <h3 class='font-heading font-bold text-xl md:text-3xl line-clamp-3 leading-tight'>
              {post.title}
            </h3>
            <p class='text-sm italic'>
              <time datetime={post.date}>
                {getDateString(new Date(post.date!))}
              </time>
            </p>
          </div>
        </a>
      ))
    }
  </div>
</div>

<script>
  import Carousel from 'embla-carousel'
  import Autoplay from 'embla-carousel-autoplay'

  const node = document.querySelector(
    '.__featured_posts_carousel'
  ) as HTMLElement

  Carousel(node, { loop: true }, [Autoplay({ delay: 7000 })])
</script>
