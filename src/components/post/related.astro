---
import type { Post } from '~/graphql/types'
import RelatedCard from './card.astro'
import { getRelatedPosts } from '~/data/posts'

interface Props {
  notIn: Array<string>
  tagIn: Array<string>
}

const { notIn, tagIn } = Astro.props
const posts = await getRelatedPosts({ notIn, tagIn })
---

<h2
  class='mb-4 border-t-2 border-tb-primary pt-2 font-subheading text-2xl font-bold uppercase text-tb-primary'
>
  Berita Terkait
</h2>
<ul class='flex flex-col gap-2'>
  {
    posts.nodes.map((post: Post, _i) =>
      _i !== posts.nodes.length - 1 ? (
        <RelatedCard post={post} />
      ) : (
        <>
          <RelatedCard post={post} />
          <li
            hx-get={`/parts/related?id=${notIn.at(0)}&tags=${tagIn.join(',')}${posts.pageInfo.hasNextPage ? `&cursor=${posts.pageInfo.endCursor}` : ''}`}
            hx-trigger='revealed'
            hx-swap='outerHTML'
          />
        </>
      )
    )
  }
</ul>
