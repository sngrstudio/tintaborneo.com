---
import type { Post } from '~/graphql/types'
import { getSiteInfo, getLogo } from '~/data/site'
import { getImage } from 'astro:assets'

interface Props {
  post: Post
}

const siteInfo = await getSiteInfo()
const logoInfo = await getLogo('logo')
const { post } = Astro.props

const logo = await getImage({ src: logoInfo.sourceUrl!, inferSize: true })
const image = post.featuredImage
  ? await getImage({ src: post.featuredImage.node.sourceUrl!, inferSize: true })
  : undefined

const JSONLD = {
  '@context': 'https://schema.org',
  '@type': 'NewsArticle',
  headline: post.title,
  image: image ? [new URL(image.src, Astro.site?.origin)] : [],
  datePublished: post.date + '+07:00',
  dateModified: post.date + '+07:00',
  author: [
    {
      '@type': 'Person',
      name: post.author?.node.name,
      jobTitle: 'Journalist',
      url: new URL(post.author?.node.uri!, Astro.site?.origin)
    }
  ],
  publisher: {
    '@type': 'Organization',
    name: siteInfo.title,
    url: Astro.site?.origin,
    logo: {
      '@type': 'ImageObject',
      url: new URL(logo.src, Astro.site?.origin)
    }
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': Astro.url
  }
}
---

<script
  type='application/ld+json'
  is:inline
  set:html={JSON.stringify(JSONLD)}
/>
