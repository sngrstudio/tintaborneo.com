---
import { Picture } from 'astro:assets'
import type { Post } from '~/data/graphql'
import { getDateString } from '~/utils/date'

interface Props {
  post: Post
}

const { post } = Astro.props
---

<li class='flex gap-2'>
  {
    post.featuredImage && (
      <a class='shrink-0 w-[160px] sm:w-[120px]' href={post.uri}>
        <Picture
          class='w-full object-cover rounded-lg'
          src={post.featuredImage.node.sourceUrl!}
          widths={[160, 120]}
          width={160}
          height={120}
          sizes='(min-width: 640px) 120px, 160px'
          alt={post.title!}
        />
      </a>
    )
  }

  <div class='flex-1 flex flex-col justify-between gap-1'>
    <a
      class='font-heading font-bold line-clamp-3 sm:line-clamp-2'
      href={post.uri}
    >
      {post.title}
    </a>
    <span class='text-tb-muted text-sm'>
      <time datetime={post.date}>{getDateString(new Date(post.date!))}</time>
    </span>
  </div>
</li>
