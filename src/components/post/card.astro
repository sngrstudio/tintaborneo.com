---
import type { Post } from '~/graphql/types'
import Picture from 'astro/components/Picture.astro'
import { getDateString } from '~/utils/date'

interface Props {
  post: Post
}

const { post } = Astro.props
---

<li class='flex gap-2'>
  {
    post.featuredImage && (
      <a class='shrink-0' href={post.uri} data-astro-prefetch>
        <Picture
          class='object-cover w-[160px] sm:w-[96px] lg:w-[120px] rounded-xl'
          src={post.featuredImage.node.sourceUrl!}
          formats={['avif', 'webp']}
          width={400}
          height={300}
          widths={[96, 120, 160]}
          sizes='(min-width: 1024px) 120px, (min-width: 640px) 96px, 160px'
          alt={post.title || ''}
        />
      </a>
    )
  }
  <div class='flex-1 flex flex-col justify-between'>
    <a
      class='font-heading font-bold line-clamp-3 sm:line-clamp-2'
      href={post.uri}
      data-astro-prefetch
    >
      {post.title}
    </a>
    <time class='text-sm' datetime={post.date}>
      {getDateString(new Date(post.date!))}
    </time>
  </div>
</li>
