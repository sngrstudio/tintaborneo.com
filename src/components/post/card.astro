---
import type { Post } from '~/graphql/types'
import Picture from 'astro/components/Picture.astro'
import { getDateString } from '~/utils/date'
import type { HTMLAttributes } from 'astro/types'

interface Props extends HTMLAttributes<'li'> {
  post: Post
}

const { post, ...attrs } = Astro.props
---

<li class='flex gap-2' {...attrs}>
  <a
    class='w-[160px] shrink-0 overflow-hidden rounded-xl bg-tb-muted/20 sm:w-[96px] lg:w-[120px]'
    href={post.uri}
    data-astro-prefetch
  >
    {
      post.featuredImage && (
        <Picture
          class='h-full w-full object-cover'
          src={post.featuredImage.node.sourceUrl!}
          formats={['avif', 'webp']}
          width={400}
          height={300}
          widths={[96, 120, 160]}
          sizes='(min-width: 1024px) 120px, (min-width: 640px) 96px, 160px'
          alt={post.title || ''}
        />
      )
    }
  </a>

  <div class='flex flex-1 flex-col justify-between'>
    <a
      class='line-clamp-3 font-heading font-bold sm:line-clamp-2'
      href={post.uri}
      data-astro-prefetch
    >
      {post.title}
    </a>
    <time class='text-sm' datetime={post.date}>
      {getDateString(post.date!)}
    </time>
  </div>
</li>
