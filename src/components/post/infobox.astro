---
import type { Post } from '~/graphql/types'
import { getDateString } from '~/utils/date'

interface Props {
  post: Post
}

const { post } = Astro.props
---

<div class='flex gap-2 font-sans text-sm'>
  <time class='italic' datetime={post.date}>
    {getDateString(post.date!, { format: 'full' })}
  </time>
  <span>|</span>
  {
    post.author && (
      <div>
        Oleh{' '}
        <a class='font-bold hover:underline' href={post.author.node.uri}>
          {post.author.node.name}
        </a>
      </div>
    )
  }
</div>
