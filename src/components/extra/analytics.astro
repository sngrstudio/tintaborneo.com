      src={import.meta.env.ANALYTICS_ENDPOINT}
      data-website-id={import.meta.env.ANALYTICS_ID}
      is:inline
    />
  )}

  {/* Clarity tracking code for https://tintaborneo.com/ */}
  <script is:inline>    
   (function(c,l,a,r,i,t,y){
    c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
    t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i+"?ref=bwt";
    y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
  })(window, document, "clarity", "script", "nn285gnxgv");
  </script>
</Fragment>