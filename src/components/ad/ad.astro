---
import { Picture } from 'astro:assets'

interface Ad {
  image: any
  className?: string
}

const { image, className = '' } = Astro.props
---

<div class={className}>
  <Picture
    class:list={['w-full object-contain sm:aspect-[4/3]']}
    src={image}
    formats={['avif', 'webp']}
    widths={[360, 1024]}
    sizes='(min-width: 640px) 1024px, 360px'
    alt={''}
  />
</div>
