---
import { Picture } from 'astro:assets'
import CopyIcon from '~icons/material-symbols/content-copy'
import ShareIcon from '~icons/material-symbols/share'
import WhatsappIcon from '~icons/simple-icons/whatsapp'
import FacebookIcon from '~icons/simple-icons/facebook'

interface Props {
  slug: string
}

const { slug } = Astro.props
---

<div
  class='flex flex-col gap-4 bg-tb-secondary rounded-xl p-4'
  x-data={`{url: '${Astro.url}'}`}
>
  <h4 class='font-heading font-bold text-tb-background text-xl text-center'>
    Share Berita Ini
  </h4>
  <div class='grid grid-cols-3 gap-2'>
    <div>
      <Picture
        src={`/og?post=${slug}&square=true`}
        width={150}
        height={150}
        alt=''
      />
    </div>
    <div class='col-span-2 flex flex-col justify-center gap-1'>
      <span class='text-sm text-tb-background'>Klik untuk Copy Link</span>
      <div
        class='flex gap-1 items-center bg-tb-background text-tb-muted px-2 py-1 rounded-full'
        role='button'
      >
        <span class='line-clamp-1 select-all text-sm' x-text='url'></span>
        <span><CopyIcon /></span>
      </div>

      <span class='text-sm text-tb-background'>Klik untuk share</span>
      <div
        class='flex justify-start gap-2 *:text-lg *:bg-tb-background *:p-1 *:rounded-full'
      >
        <button><ShareIcon /></button>
        <button><WhatsappIcon /></button>
        <button><FacebookIcon /></button>
      </div>
    </div>
  </div>
</div>
