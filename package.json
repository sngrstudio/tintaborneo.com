{
  "name": "mediakit-front-template",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "astro": "astro",
    "build": "pnpm check && pnpm gen-icons && astro build",
    "check": "pnpx concurrently \"astro check\" \"tsc --noEmit\" \"prettier --check .\"",
    "codegen": "graphql-codegen --config codegen.ts",
    "dev": "astro dev",
    "format": "prettier --write .",
    "gen-icons": "pwa-assets-generator --manifest=false --preset minimal-2023 public/icon.svg",
    "preinstall": "npx only-allow pnpm",
    "preview": "astro preview",
    "start": "astro dev"
  },
  "dependencies": {
    "@astrojs/alpinejs": "0.4.0",
    "@astrojs/node": "8.2.5",
    "@astrojs/react": "3.3.4",
    "@astrojs/rss": "4.0.5",
    "@astrojs/tailwind": "5.1.0",
    "@fastify/middie": "8.3.1",
    "@fastify/static": "7.0.4",
    "@fontsource/martel-sans": "5.0.14",
    "@fontsource/source-serif-pro": "5.0.8",
    "alpinejs": "3.13.10",
    "astro": "4.8.3",
    "astro-htmx": "1.0.5",
    "astro-seo": "0.8.3",
    "date-fns": "3.6.0",
    "embla-carousel-autoplay": "8.0.4",
    "embla-carousel-react": "8.0.4",
    "fastify": "4.27.0",
    "graphql": "16.8.1",
    "htmx.org": "1.9.12",
    "postcss-preset-env": "9.5.13",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "satori": "0.10.13",
    "sharp": "0.33.3",
    "tailwindcss": "3.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.6.0",
    "@graphql-codegen/cli": "5.0.2",
    "@graphql-codegen/typescript": "4.0.6",
    "@iconify-json/eos-icons": "1.1.10",
    "@iconify-json/material-symbols": "1.1.79",
    "@tailwindcss/typography": "0.5.13",
    "@types/alpinejs": "3.13.10",
    "@types/react": "18.3.2",
    "@types/react-dom": "18.3.0",
    "@vite-pwa/assets-generator": "0.2.4",
    "dotenv": "16.4.5",
    "prettier": "3.2.5",
    "prettier-config-standard": "7.0.0",
    "prettier-plugin-astro": "0.13.0",
    "typescript": "5.4.5",
    "unplugin-icons": "0.19.0"
  },
  "packageManager": "pnpm@9.1.0+sha256.22e36fba7f4880ecf749a5ca128b8435da085ecd49575e7fb9e64d6bf4fad394"
