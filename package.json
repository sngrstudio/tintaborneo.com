{
  "name": "mediakit-front-template",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "astro": "astro",
    "build": "conc pnpm:check:* && conc pnpm:gen:icons && astro build",
    "check:astro": "astro check",
    "check:format": "prettier --check .",
    "check:ts": "tsc --noEmit",
    "dev": "astro dev",
    "format": "prettier --write .",
    "gen:graphql": "graphql-codegen --config codegen.ts",
    "gen:icons": "pwa-assets-generator --manifest=false --preset minimal-2023 public/icon.svg",
    "preview": "wrangler types && conc pnpm:build && wrangler pages dev ./dist",
    "start": "conc pnpm:dev"
  },
  "dependencies": {
    "@astrojs/alpinejs": "0.4.0",
    "@astrojs/cloudflare": "^11.0.1",
    "@astrojs/react": "3.6.0",
    "@astrojs/rss": "4.0.7",
    "@astrojs/tailwind": "5.1.0",
    "@fontsource/martel-sans": "5.0.14",
    "@fontsource/source-serif-pro": "5.0.8",
    "alpinejs": "3.14.1",
    "astro": "4.11.3",
    "date-fns": "3.6.0",
    "embla-carousel-autoplay": "8.1.5",
    "embla-carousel-react": "8.1.5",
    "graphql": "16.9.0",
    "htmx.org": "2.0.0",
    "postcss-preset-env": "9.5.14",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "satori": "0.10.13",
    "sharp": "0.33.4",
    "tailwindcss": "3.4.4"
  },
  "devDependencies": {
    "@astrojs/check": "0.7.0",
    "@cloudflare/workers-types": "^4.20240620.0",
    "@graphql-codegen/cli": "5.0.2",
    "@graphql-codegen/typescript": "4.0.7",
    "@iconify-json/eos-icons": "1.1.10",
    "@iconify-json/material-symbols": "1.1.82",
    "@iconify-json/simple-icons": "1.1.107",
    "@tailwindcss/typography": "0.5.13",
    "@types/alpinejs": "3.13.10",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@vite-pwa/assets-generator": "0.2.4",
    "concurrently": "8.2.2",
    "dotenv": "16.4.5",
    "prettier": "3.3.2",
    "prettier-config-standard": "7.0.0",
    "prettier-plugin-astro": "0.14.0",
    "typescript": "^5.5.2",
    "unplugin-icons": "0.19.0",
    "wrangler": "3.62.0"
  },
  "packageManager": "pnpm@9.4.0+sha512.f549b8a52c9d2b8536762f99c0722205efc5af913e77835dbccc3b0b0b2ca9e7dc8022b78062c17291c48e88749c70ce88eb5a74f1fa8c4bf5e18bb46c8bd83a"
}
