{
  "name": "mediakit-front-template",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "astro": "astro",
    "build": "pnpm check && pnpm gen-icons && astro build",
    "check": "conc \"prettier --check .\" \"astro check\" \"tsc --noEmit\"",
    "codegen": "graphql-codegen --config codegen.ts",
    "dev": "astro dev",
    "format": "prettier --write .",
    "gen-icons": "pwa-assets-generator --manifest=false --preset minimal-2023 public/icon.svg",
    "preinstall": "npx only-allow pnpm",
    "preview": "astro preview",
    "start": "astro dev"
  },
  "dependencies": {
    "@astrojs/alpinejs": "0.4.0",
    "@astrojs/node": "8.3.1",
    "@astrojs/react": "3.6.0",
    "@astrojs/rss": "4.0.6",
    "@astrojs/tailwind": "5.1.0",
    "@fastify/middie": "8.3.1",
    "@fastify/static": "7.0.4",
    "@fontsource/martel-sans": "5.0.14",
    "@fontsource/source-serif-pro": "5.0.8",
    "alpinejs": "3.14.1",
    "astro": "4.11.0",
    "date-fns": "3.6.0",
    "embla-carousel-autoplay": "8.1.5",
    "embla-carousel-react": "8.1.5",
    "fastify": "4.28.0",
    "graphql": "16.9.0",
    "htmx.org": "2.0.0",
    "postcss-preset-env": "9.5.14",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "satori": "0.10.13",
    "sharp": "0.33.4",
    "tailwindcss": "3.4.4"
  },
  "devDependencies": {
    "@astrojs/check": "0.7.0",
    "@graphql-codegen/cli": "5.0.2",
    "@graphql-codegen/typescript": "4.0.7",
    "@iconify-json/eos-icons": "1.1.10",
    "@iconify-json/material-symbols": "1.1.82",
    "@iconify-json/simple-icons": "1.1.107",
    "@tailwindcss/typography": "0.5.13",
    "@types/alpinejs": "3.13.10",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@vite-pwa/assets-generator": "0.2.4",
    "concurrently": "8.2.2",
    "dotenv": "16.4.5",
    "prettier": "3.3.2",
    "prettier-config-standard": "7.0.0",
    "prettier-plugin-astro": "0.14.0",
    "typescript": "5.5.2",
    "unplugin-icons": "0.19.0"
  },
  "packageManager": "pnpm@9.1.4"
}
