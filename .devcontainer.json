{
  "image": "mcr.microsoft.com/devcontainers/universal:2-linux",
  "customizations": {
    "vscode": {
      "extensions": [
        "astro-build.astro-vscode",
        "bradlc.vscode-tailwindcss",
        "GitHub.vscode-github-actions",
        "mhutchie.git-graph",
        "sourcegraph.cody-ai"
      ]
    }
  },
  "features": {
    "ghcr.io/devcontainers-contrib/features/cloudflare-wrangler:1": {}
  },
  "postCreateCommand": "echo \"ADMIN_ENDPOINT=${ADMIN_ENDPOINT}\" > .dev.vars && echo \"MODE=dev\" >> .dev.vars && corepack prepare && corepack enable && pnpm install --frozen-lockfile"
}
