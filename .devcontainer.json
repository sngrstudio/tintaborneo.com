{
  "image": "mcr.microsoft.com/devcontainers/universal:2-linux",
  "customizations": {
    "vscode": {
      "extensions": [
        "astro-build.astro-vscode",
        "bradlc.vscode-tailwindcss",
        "GitHub.vscode-github-actions",
        "mhutchie.git-graph",
        "sourcegraph.cody-ai"
      ]
    }
  },
  "postCreateCommand": "echo \"ADMIN_ENDPOINT=${ADMIN_ENDPOINT}\" > .env && pnpm install"
}
